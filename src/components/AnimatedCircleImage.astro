---
interface Props {
    src: string;
    alt: string;
    size?: string;
    class?: string;
}

const { src, alt, size = "150px", class: className } = Astro.props;
---

<div
    class:list={["animated-circle-image", className]}
    style={`--size: ${size}`}
>
    <div class="image-wrapper">
        <img src={src} alt={alt} />
    </div>
    <svg class="scribble-svg" viewBox="0 0 100 100">
        <circle
            cx="50"
            cy="50"
            r="45"
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="3"
            stroke-linecap="round"
            class="scribble-path"></circle>
    </svg>
</div>

<style>
    .animated-circle-image {
        position: relative;
        width: var(--size);
        height: var(--size);
        margin: 2rem auto;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .image-wrapper {
        width: 85%;
        height: 85%;
        border-radius: 50%;
        overflow: hidden;
        position: relative;
        z-index: 2;
        background: var(--color-bg-offset);
    }

    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .scribble-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
        transform: rotate(-10deg);
    }

    .scribble-path {
        stroke-dasharray: 300;
        stroke-dashoffset: 300;
        animation:
            drawCircle 1.5s ease-out forwards,
            pulseBorder 3s infinite 1.5s;
    }

    @keyframes drawCircle {
        to {
            stroke-dashoffset: 0;
        }
    }

    @keyframes pulseBorder {
        0%,
        100% {
            transform: scale(1);
            stroke-width: 3;
        }
        50% {
            transform: scale(1.05);
            stroke-width: 2;
        }
    }
</style>
