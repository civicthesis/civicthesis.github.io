---
import ThemeToggle from "./ThemeToggle.astro";
import Search from "./Search.astro";
import { getCollection } from "astro:content";

// Fetch collections to generate dynamic category links
const blogEntries = await getCollection("blog");
const storyEntries = await getCollection("stories");

const allTags = [
  ...storyEntries.map((e) => (e.data.category ? [e.data.category] : [])).flat(),
  // ...blogEntries.map((e) => e.data.tags).flat(),
];

// Count tag frequency
const tagCounts = allTags.reduce(
  (acc, tag) => {
    const normalizedTag = tag.trim();
    acc[normalizedTag] = (acc[normalizedTag] || 0) + 1;
    return acc;
  },
  {} as Record<string, number>,
);

// Sort by frequency and take top 10
const topTags = Object.keys(tagCounts)
  .sort((a, b) => tagCounts[b] - tagCounts[a])
  .slice(0, 10);

// Capitalize helper
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const pathname = Astro.url.pathname;
const isStoriesActive = pathname === "/stories" || pathname === "/stories/";
---

<header>
  <div class="container header-content">
    <a href="/" class="logo">
      <span class="civic">CIVIC</span>
      <span class="thesis">Thesis</span>
    </a>

    <div class="header-actions">
      <!-- Search is always visible -->
      <Search />

      <!-- Desktop Navigation -->
      <nav class="desktop-nav">
        <!-- <a href="/">Blog</a> -->
        <a href="/stories">Stories</a>
        <!-- <a href="/education">Education</a> -->
        <ThemeToggle />
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="mobile-menu-btn"
        aria-label="Open Menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Category/Tags Navigation -->
  <div class="container mobile-categories">
    <div id="current-date" class="current-date"></div>
    <div class="category-nav-wrapper">
      <button id="scroll-left" class="scroll-btn left" aria-label="Scroll left">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <nav class="category-scroll" id="category-scroll-container">
        <a
          href="/stories"
          class={`category-link ${isStoriesActive ? "active" : ""}`}>All</a
        >
        {
          topTags.map((tag) => {
            const tagPath = `/${tag}`;
            const isActive = pathname.includes(tagPath);
            return (
              <a
                href={tagPath}
                class={`category-link ${isActive ? "active" : ""}`}
              >
                {capitalize(tag)}
              </a>
            );
          })
        }
      </nav>
      <button
        id="scroll-right"
        class="scroll-btn right"
        aria-label="Scroll right"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="mobile-menu">
    <div class="mobile-menu-content">
      <div class="mobile-header">
        <span class="mobile-title">Menu</span>
        <button
          id="close-menu-btn"
          class="close-menu-btn"
          aria-label="Close Menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <nav class="mobile-nav">
        <a href="/">Blog</a>
        <a href="/stories">Stories</a>
        <a href="/education">Education</a>
        <div class="mobile-theme-toggle">
          <span>Theme</span>
          <ThemeToggle />
        </div>
        <div id="mobile-date" class="mobile-date"></div>
      </nav>
    </div>
    <div class="mobile-backdrop"></div>
  </div>
</header>

<style>
  header {
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-xl);
    background-color: var(--color-bg);
    /* position: sticky; */
    top: 0;
    z-index: 40;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 950px; /* Increased from default 800px */
  }

  .logo {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 0.4rem;
    line-height: 1;
    text-decoration: none;
    z-index: 50;
    margin-right: 1rem;
  }

  .civic {
    font-family: "Montserrat", sans-serif;
    font-family: var(--font-carrois);
    font-weight: 700;
    font-size: 1.8rem;
    color: var(--color-logo-text);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .thesis {
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.8rem;
    color: var(--color-secondary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .desktop-nav a {
    font-family: var(--font-carrois);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    position: relative;
  }

  .desktop-nav a:hover {
    color: var(--color-primary);
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    padding: 0.5rem;
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 100;
    visibility: hidden;
    opacity: 0;
    transition:
      visibility 0s linear 0.3s,
      opacity 0.3s ease;
  }

  .mobile-menu.open {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }

  .mobile-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    /* backdrop-filter: blur(4px); */
    z-index: 101;
  }

  .mobile-menu-content {
    position: absolute;
    top: 0;
    right: 0;
    width: 80%;
    max-width: 300px;
    height: 100%;
    background: var(--color-bg);
    z-index: 102;
    padding: 2rem;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -5px 0 30px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .mobile-menu.open .mobile-menu-content {
    transform: translateX(0);
  }

  .mobile-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mobile-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .close-menu-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    padding: 0.5rem;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-nav a {
    font-family: var(--font-carrois);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-theme-toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .mobile-date {
    font-family: var(--font-carrois);
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.95rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  /* Responsive Styles */
  @media (max-width: 768px) {
    header {
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .civic,
    .thesis {
      font-size: 1.4rem;
    }

    .header-actions {
      gap: 0.75rem;
    }

    /* Ensure logo doesn't break */
    .logo {
      gap: 0.25rem;
    }
  }

  /* Category Scroll Styles */
  .mobile-categories {
    /* Category Scroll Styles */
    /* .mobile-categories { */
    max-width: 950px;
    margin-top: 0.5rem;
    padding-bottom: 0px; /* Slight adjust */
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .current-date {
    font-family: var(--font-carrois);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    text-transform: capitalize;
    display: none; /* Hidden on small screens */
    min-width: 169px;
  }

  @media (min-width: 768px) {
    .current-date {
      display: block;
    }
  }

  .category-nav-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
    min-width: 0;
    gap: 0.5rem;
  }

  .scroll-btn {
    display: none; /* Hidden on mobile by default, shown via JS/media query if needed */
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 4px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .scroll-btn:hover {
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .scroll-btn {
      display: flex; /* Show on desktop */
    }
  }

  .category-scroll {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding-bottom: 0px;
    scrollbar-width: none; /* Hide scrollbar Firefox */
    -ms-overflow-style: none; /* Hide scrollbar IE/Edge */
    flex: 1;
    scroll-behavior: smooth;
    align-items: center;
  }

  /* Hide scrollbar for Webkit */
  .category-scroll::-webkit-scrollbar {
    display: none;
  }

  .category-link {
    white-space: nowrap;
    font-family: var(--font-carrois);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    transition: all 0.2s;
    flex-shrink: 0;
    text-transform: capitalize;
    position: relative;
    padding: 0.25rem 0; /* Add touch target area */
  }

  .category-link:hover {
    color: var(--color-primary);
  }

  .category-link.active {
    border-bottom: 2px solid var(--color-heading);
    color: var(--color-heading);
  }
</style>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("close-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const backdrop = document.querySelector(".mobile-backdrop");

  function toggleMenu() {
    mobileMenu?.classList.toggle("open");
    document.body.style.overflow = mobileMenu?.classList.contains("open")
      ? "hidden"
      : "";
  }

  menuBtn?.addEventListener("click", toggleMenu);
  closeBtn?.addEventListener("click", toggleMenu);
  backdrop?.addEventListener("click", toggleMenu);

  // Close menu when clicking a link
  const mobileLinks = document.querySelectorAll(".mobile-nav a");
  mobileLinks.forEach((link) => {
    link.addEventListener("click", toggleMenu);
  });

  // Date Logic
  const dateElement = document.getElementById("current-date");
  if (dateElement) {
    const options: Intl.DateTimeFormatOptions = {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric",
    };
    const now = new Date();
    const formattedDate = now.toLocaleDateString("en-US", options);
    dateElement.textContent = formattedDate;

    const mobileDateElement = document.getElementById("mobile-date");
    if (mobileDateElement) {
      mobileDateElement.textContent = formattedDate;
    }
  }

  // Category Scroll Logic
  const scrollContainer = document.getElementById("category-scroll-container");
  const scrollLeftBtn = document.getElementById("scroll-left");
  const scrollRightBtn = document.getElementById("scroll-right");

  if (scrollContainer && scrollLeftBtn && scrollRightBtn) {
    const scrollAmount = 200; // Adjust as needed

    scrollLeftBtn.addEventListener("click", () => {
      scrollContainer.scrollBy({ left: -scrollAmount, behavior: "smooth" });
    });

    scrollRightBtn.addEventListener("click", () => {
      scrollContainer.scrollBy({ left: scrollAmount, behavior: "smooth" });
    });
  }
</script>
