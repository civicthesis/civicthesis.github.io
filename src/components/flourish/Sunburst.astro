---
import FlourishContainer from "./FlourishContainer.astro";

interface Props {
    data: {
        name: string;
        value?: number;
        children?: any[];
        color?: string;
    };
    title?: string;
    subtitle?: string;
    source?: string;
    height?: number;
    theme?: "light" | "dark" | "auto";
}

const {
    data,
    title = "Sunburst Analysis",
    subtitle = "Hierarchical data visualization",
    source,
    height = 500,
    theme = "auto",
} = Astro.props;

const uniqueId = `sunburst-${Math.random().toString(36).substr(2, 9)}`;
---

<FlourishContainer
    title={title}
    subtitle={subtitle}
    source={source}
    theme={theme}
    allowFullscreen={true}
>
    <div
        id={uniqueId}
        class="sunburst-container"
        style={`height: ${height}px;`}
        data-chart-config={JSON.stringify({ data, theme })}
    >
        <!-- Tooltip -->
        <div class="sunburst-tooltip"></div>
        <!-- Canvas/SVG Area -->
        <div class="chart-area"></div>
    </div>
</FlourishContainer>

<style>
    .sunburst-container {
        position: relative;
        width: 100%;
        overflow: hidden;
        user-select: none;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .chart-area {
        width: 100%;
        height: 100%;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Tooltip */
    .sunburst-tooltip {
        position: absolute;
        top: 0;
        left: 0;
        background: rgba(0, 0, 0, 0.85);
        color: #fff;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 0.85rem;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, -100%);
        transition:
            opacity 0.2s,
            transform 0.2s;
        z-index: 10;
        white-space: nowrap;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .sunburst-tooltip::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        margin-left: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: rgba(0, 0, 0, 0.85) transparent transparent transparent;
    }

    /* Path Styling */
    .sunburst-container :global(path) {
        stroke: #fff;
        stroke-width: 1px;
        transition: opacity 0.3s;
        cursor: pointer;
    }

    .sunburst-container :global(path:hover) {
        opacity: 0.8;
    }
</style>

<script>
    // @ts-nocheck
    class SunburstChart {
        el;
        config;
        chartArea;
        tooltip;
        resizeTimer;

        constructor(el) {
            this.el = el;
            this.config = JSON.parse(el.dataset.chartConfig || "{}");
            this.chartArea = el.querySelector(".chart-area");
            this.tooltip = el.querySelector(".sunburst-tooltip");
            this.init();
        }

        init() {
            if (!this.config.data) return;
            this.render(this.config.data);
            window.addEventListener("resize", () => {
                clearTimeout(this.resizeTimer);
                this.resizeTimer = setTimeout(
                    () => this.render(this.config.data),
                    200,
                );
            });
        }

        // Helper: Convert Polar to Cartesian
        polarToCartesian(centerX, centerY, radius, angleInRadians) {
            // SVG coordinate system: 0 degrees is typically 3 o'clock.
            // We want 0 degrees at 12 o'clock, so subtract PI/2.
            const angle = angleInRadians - Math.PI / 2;
            return {
                x: centerX + radius * Math.cos(angle),
                y: centerY + radius * Math.sin(angle),
            };
        }

        describeArc(x, y, innerRadius, outerRadius, startAngle, endAngle) {
            const start = this.polarToCartesian(x, y, outerRadius, endAngle);
            const end = this.polarToCartesian(x, y, outerRadius, startAngle);
            const startInner = this.polarToCartesian(
                x,
                y,
                innerRadius,
                endAngle,
            );
            const endInner = this.polarToCartesian(
                x,
                y,
                innerRadius,
                startAngle,
            );

            const largeArcFlag = endAngle - startAngle <= Math.PI ? "0" : "1";

            const d = [
                "M",
                start.x,
                start.y,
                "A",
                outerRadius,
                outerRadius,
                0,
                largeArcFlag,
                0,
                end.x,
                end.y,
                "L",
                endInner.x,
                endInner.y,
                "A",
                innerRadius,
                innerRadius,
                0,
                largeArcFlag,
                1,
                startInner.x,
                startInner.y,
                "Z",
            ].join(" ");

            return d;
        }

        partition(root) {
            // Assign values
            const addValue = (node) => {
                if (!node.children || node.children.length === 0)
                    return node.value || 0;
                node.value = node.children.reduce(
                    (acc, c) => acc + addValue(c),
                    0,
                );
                return node.value;
            };
            addValue(root);

            const nodes = [];
            const traverse = (node, startAngle, endAngle, depth) => {
                const nodeObj = { ...node, startAngle, endAngle, depth };
                nodes.push(nodeObj);

                if (node.children) {
                    const total = node.value;
                    let currentAngle = startAngle;
                    node.children.forEach((child) => {
                        const angle =
                            (child.value / total) * (endAngle - startAngle);
                        traverse(
                            child,
                            currentAngle,
                            currentAngle + angle,
                            depth + 1,
                        );
                        currentAngle += angle;
                    });
                }
            };
            traverse(root, 0, 2 * Math.PI, 0);
            return nodes;
        }

        render(data) {
            this.chartArea.innerHTML = "";
            let { width, height } = this.el.getBoundingClientRect();
            if (!width || width === 0)
                width = this.el.offsetWidth || this.el.clientWidth || 800;
            if (!height || height === 0)
                height = this.el.offsetHeight || this.el.clientHeight || 500;

            const radius = Math.min(width, height) / 2;
            const centerX = width / 2;
            const centerY = height / 2;

            // Partition layout
            const root = JSON.parse(JSON.stringify(data)); // Deep copy
            const nodes = this.partition(root);
            const maxDepth = Math.max(...nodes.map((n) => n.depth));
            // Reserve space for center hole (optional) or just scale
            const layerThickness = radius / (maxDepth + 1);

            const svg = document.createElementNS(
                "http://www.w3.org/2000/svg",
                "svg",
            );
            svg.setAttribute("width", "100%");
            svg.setAttribute("height", "100%");
            svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
            this.chartArea.appendChild(svg);

            const colorPalette = [
                "#3B82F6",
                "#EF4444",
                "#10B981",
                "#F59E0B",
                "#6366F1",
                "#EC4899",
                "#8B5CF6",
                "#14B8A6",
                "#F97316",
                "#06B6D4",
            ];

            nodes.forEach((node, i) => {
                // Skip root if desired, or render it in center
                if (node.depth === 0) return; // Often root is not drawn in sunburst

                const innerRadius = node.depth * layerThickness;
                const outerRadius = (node.depth + 1) * layerThickness;

                const path = document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "path",
                );
                const d = this.describeArc(
                    centerX,
                    centerY,
                    innerRadius,
                    outerRadius,
                    node.startAngle,
                    node.endAngle,
                );
                path.setAttribute("d", d);
                path.setAttribute(
                    "fill",
                    node.color || colorPalette[i % colorPalette.length],
                );

                // Tooltip
                const tooltipContent = `
                    <div style="font-weight:600; margin-bottom:4px;">${node.name}</div>
                    <div style="display:flex; justify-content:space-between; gap:1rem;">
                        <span>Value:</span>
                        <span style="font-weight:600;">${Math.round(node.value).toLocaleString()}</span>
                    </div>
                `;

                path.addEventListener("mouseenter", (e) => {
                    this.tooltip.style.opacity = "1";
                    this.tooltip.innerHTML = tooltipContent;
                    path.style.opacity = "0.7";
                });
                path.addEventListener("mousemove", (e) => {
                    const chartRect = this.el.getBoundingClientRect();
                    this.tooltip.style.left = `${e.clientX - chartRect.left}px`;
                    this.tooltip.style.top = `${e.clientY - chartRect.top - 10}px`;
                });
                path.addEventListener("mouseleave", () => {
                    this.tooltip.style.opacity = "0";
                    path.style.opacity = "1";
                });

                svg.appendChild(path);

                // Animate (simple fade in)
                path.style.opacity = "0";
                path.animate(
                    [
                        {
                            opacity: 0,
                            transform: "scale(0.9)",
                            transformOrigin: "center",
                        },
                        {
                            opacity: 1,
                            transform: "scale(1)",
                            transformOrigin: "center",
                        },
                    ],
                    {
                        duration: 500,
                        delay: node.depth * 200 + node.startAngle * 100, // Stagger by depth and angle
                        fill: "forwards",
                        easing: "ease-out",
                    },
                );
            });
        }
    }

    // Init
    function initSunburst() {
        document.querySelectorAll(".sunburst-container").forEach((el) => {
            const element = el;
            if (!element.dataset.initialized) {
                new SunburstChart(element);
                element.dataset.initialized = "true";
            }
        });
    }

    initSunburst();
    document.addEventListener("astro:page-load", initSunburst);
</script>
