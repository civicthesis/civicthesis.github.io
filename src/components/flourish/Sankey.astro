---
import FlourishContainer from "./FlourishContainer.astro";

interface Props {
    data: {
        nodes: { name: string; color?: string }[];
        links: { source: string; target: string; value: number }[];
    };
    title?: string;
    subtitle?: string;
    source?: string;
    height?: number;
    theme?: "light" | "dark" | "auto";
}

const {
    data,
    title = "Sankey Flow",
    subtitle = "Flow visualization",
    source,
    height = 500,
    theme = "auto",
} = Astro.props;

const uniqueId = `sankey-${Math.random().toString(36).substr(2, 9)}`;
---

<FlourishContainer
    title={title}
    subtitle={subtitle}
    source={source}
    theme={theme}
    allowFullscreen={true}
>
    <div
        id={uniqueId}
        class="sankey-container"
        style={`height: ${height}px;`}
        data-chart-config={JSON.stringify({ data, theme })}
    >
        <!-- Tooltip -->
        <div class="sankey-tooltip"></div>
        <!-- Canvas/SVG Area -->
        <div class="chart-area"></div>
    </div>
</FlourishContainer>

<style>
    .sankey-container {
        position: relative;
        width: 100%;
        overflow: hidden;
        user-select: none;
    }

    .chart-area {
        width: 100%;
        height: 100%;
        position: relative;
    }

    /* Tooltip */
    .sankey-tooltip {
        position: absolute;
        top: 0;
        left: 0;
        background: rgba(0, 0, 0, 0.85);
        color: #fff;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 0.85rem;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, -100%);
        transition:
            opacity 0.2s,
            transform 0.2s;
        z-index: 10;
        white-space: nowrap;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .sankey-tooltip::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        margin-left: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: rgba(0, 0, 0, 0.85) transparent transparent transparent;
    }

    /* Link Styling */
    .sankey-container :global(path.link) {
        fill: none;
        stroke-opacity: 0.2;
        transition: stroke-opacity 0.3s;
        cursor: pointer;
    }

    .sankey-container :global(path.link:hover) {
        stroke-opacity: 0.5;
    }

    /* Node Styling */
    .sankey-container :global(rect.node) {
        cursor: pointer;
        shape-rendering: crispEdges;
    }

    .sankey-container :global(text.node-label) {
        pointer-events: none;
        font-size: 12px;
        font-weight: 500;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        fill: currentColor;
    }
</style>

<script>
    // @ts-nocheck
    class SankeyChart {
        el;
        config;
        chartArea;
        tooltip;
        resizeTimer;

        constructor(el) {
            this.el = el;
            this.config = JSON.parse(el.dataset.chartConfig || "{}");
            this.chartArea = el.querySelector(".chart-area");
            this.tooltip = el.querySelector(".sankey-tooltip");
            this.init();
        }

        init() {
            if (!this.config.data) return;
            this.render(this.config.data);
            window.addEventListener("resize", () => {
                clearTimeout(this.resizeTimer);
                this.resizeTimer = setTimeout(
                    () => this.render(this.config.data),
                    200,
                );
            });
        }

        // Simple Sankey Layout Algorithm
        computeSankeyLayout(data, width, height) {
            const { nodes: rawNodes, links: rawLinks } = data;
            const nodeMap = new Map();
            const nodes = rawNodes.map((n, i) => {
                const node = {
                    ...n,
                    index: i,
                    sourceLinks: [],
                    targetLinks: [],
                    value: 0,
                };
                nodeMap.set(n.name, node);
                return node;
            });

            const links = rawLinks
                .map((l) => {
                    const source = nodeMap.get(l.source);
                    const target = nodeMap.get(l.target);
                    return { ...l, source, target, value: l.value };
                })
                .filter((l) => l.source && l.target);

            // 1. Compute Node Values
            links.forEach((link) => {
                link.source.sourceLinks.push(link);
                link.target.targetLinks.push(link);
            });

            nodes.forEach((node) => {
                node.value = Math.max(
                    node.sourceLinks.reduce((sum, l) => sum + l.value, 0),
                    node.targetLinks.reduce((sum, l) => sum + l.value, 0),
                );
            });

            // 2. Assign Columns (Depth) - Simple Iterative Approach
            // Initialize with root nodes (no targets)
            let currentLayer = nodes.filter((n) => n.targetLinks.length === 0);
            if (currentLayer.length === 0 && nodes.length > 0)
                currentLayer = [nodes[0]]; // Fallback for circular

            let layers = [];
            const seen = new Set();

            // Assign remaining
            // Actually, let's use a simpler "x" coordinate based on topology sort or just inputs
            // For simplicity in this specialized component, let's assume a DAG and just do a quick depth calculation

            const computeDepth = (node, depth = 0) => {
                if (node.depth !== undefined && node.depth >= depth) return;
                node.depth = depth;
                node.sourceLinks.forEach((link) => {
                    computeDepth(link.target, depth + 1);
                });
            };

            // Find roots
            const roots = nodes.filter((n) => n.targetLinks.length === 0);
            if (roots.length === 0 && nodes.length > 0) computeDepth(nodes[0]);
            else roots.forEach((r) => computeDepth(r));

            const maxDepth = Math.max(...nodes.map((n) => n.depth || 0));

            // 3. Assign Coordinates
            const margin = { top: 20, right: 100, bottom: 20, left: 20 };
            const contentWidth = width - margin.left - margin.right;
            const contentHeight = height - margin.top - margin.bottom;
            const nodeWidth = 20;
            const layerWidth = contentWidth / maxDepth;
            const k =
                contentHeight /
                (nodes.reduce((sum, n) => sum + n.value, 0) * 0.5); // heuristic scale? No, better per layer

            // Group by depth
            const nodesByDepth = Array.from({ length: maxDepth + 1 }, () => []);
            nodes.forEach((n) => {
                const d = n.depth || 0;
                // Force sink nodes to right? Optional.
                nodesByDepth[d].push(n);
            });

            // Calculate Y positions per layer
            const padding = 10;
            nodesByDepth.forEach((layer, i) => {
                const totalValue = layer.reduce((sum, n) => sum + n.value, 0);
                const scale =
                    (contentHeight - (layer.length - 1) * padding) / totalValue;
                // Or better: fit to max possible contentHeight

                // Let's use a global scale factor based on the "busiest" column max value?
                // Or just independent scaling per column? Independent looks weird.
                // Let's find global max layer value sum

                // Simplified: just stack them
                let y = margin.top;

                // Sort layer?
                layer.sort((a, b) => b.value - a.value);

                // Re-calculate local scale for this exact column to fill height?
                // Sankey usually preserves flow width across columns.
                // So we need a global ky.
            });

            // Global KY
            const maxLayerValue = Math.max(
                ...nodesByDepth.map((layer) =>
                    layer.reduce((s, n) => s + n.value, 0),
                ),
            );
            const ky =
                (contentHeight -
                    Math.max(...nodesByDepth.map((l) => l.length)) * padding) /
                maxLayerValue;

            nodesByDepth.forEach((layer, i) => {
                let y = margin.top;
                layer.sort((a, b) => b.value - a.value); // Naive sort

                layer.forEach((node) => {
                    node.x = margin.left + i * layerWidth;
                    node.y = y;
                    node.dy = node.value * ky;
                    node.dx = nodeWidth;
                    y += node.dy + padding;
                });
            });

            // 4. Compute Links coordinates
            links.forEach((link) => {
                link.sy = link.source.y + link.source.dy * 0.5; // Center for now? No, need stacks
                link.ty = link.target.y + link.target.dy * 0.5;
            });

            // Stacking links on source and target nodes
            nodes.forEach((node) => {
                let sy = 0;
                let ty = 0;
                // Sort links?
                node.sourceLinks.sort((a, b) => a.target.y - b.target.y);
                node.targetLinks.sort((a, b) => a.source.y - b.source.y);

                node.sourceLinks.forEach((link) => {
                    link.sy = node.y + sy + (link.value * ky) / 2; // Center of the ribbon segment
                    link.dy = link.value * ky;
                    sy += link.dy;
                });

                node.targetLinks.forEach((link) => {
                    link.ty = node.y + ty + (link.value * ky) / 2;
                    link.dy = link.value * ky; // Same width
                    ty += link.dy;
                });
            });

            return { nodes, links };
        }

        render(data) {
            this.chartArea.innerHTML = "";
            let { width, height } = this.el.getBoundingClientRect();
            if (!width || width === 0)
                width = this.el.offsetWidth || this.el.clientWidth || 800;
            if (!height || height === 0)
                height = this.el.offsetHeight || this.el.clientHeight || 500;

            const { nodes, links } = this.computeSankeyLayout(
                JSON.parse(JSON.stringify(data)),
                width,
                height,
            );

            const svg = document.createElementNS(
                "http://www.w3.org/2000/svg",
                "svg",
            );
            svg.setAttribute("width", "100%");
            svg.setAttribute("height", "100%");
            svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
            this.chartArea.appendChild(svg);

            const colorPalette = [
                "#3B82F6",
                "#EF4444",
                "#10B981",
                "#F59E0B",
                "#6366F1",
                "#EC4899",
                "#8B5CF6",
                "#14B8A6",
                "#F97316",
                "#06B6D4",
            ];

            // Draw Links
            links.forEach((link, i) => {
                const path = document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "path",
                );

                // Cubic Bezier
                // M sourceX, sourceY C cp1x, cp1y cp2x, cp2y targetX, targetY
                // Ribbon requires drawing the shape? Or usually just a thick stroke for simple sankeys.
                // Standard D3 Sankey draws a path with a stroke-width = link.dy.

                const sx = link.source.x + link.source.dx;
                const tx = link.target.x;
                const sy = link.sy;
                const ty = link.ty;

                const curvature = 0.5;
                const xi = d3_interpolateNumber(sx, tx);
                const x2 = xi(curvature);
                const x3 = xi(1 - curvature);

                // Simple Bezier for stroke
                const d = `M${sx},${sy} C${x2},${sy} ${x3},${ty} ${tx},${ty}`;

                path.setAttribute("d", d);
                path.setAttribute("class", "link");
                path.setAttribute(
                    "stroke",
                    link.source.color ||
                        colorPalette[link.source.index % colorPalette.length],
                );
                path.setAttribute("stroke-width", Math.max(1, link.dy));

                // Tooltip
                const tooltipContent = `
                    <div style="font-weight:600; margin-bottom:4px;">${link.source.name} → ${link.target.name}</div>
                    <div style="font-weight:600;">${link.value.toLocaleString()}</div>
                `;

                path.addEventListener("mouseenter", (e) => {
                    this.tooltip.style.opacity = "1";
                    this.tooltip.innerHTML = tooltipContent;
                });
                path.addEventListener("mousemove", (e) => {
                    const chartRect = this.el.getBoundingClientRect();
                    this.tooltip.style.left = `${e.clientX - chartRect.left}px`;
                    this.tooltip.style.top = `${e.clientY - chartRect.top - 10}px`;
                });
                path.addEventListener("mouseleave", () => {
                    this.tooltip.style.opacity = "0";
                });

                svg.appendChild(path);

                // Animate Draw
                const length = path.getTotalLength();
                path.style.strokeDasharray = length;
                path.style.strokeDashoffset = length;
                path.animate(
                    [{ strokeDashoffset: length }, { strokeDashoffset: 0 }],
                    {
                        duration: 1000,
                        delay: i * 50,
                        easing: "ease-out",
                        fill: "forwards",
                    },
                );
            });

            // Draw Nodes
            nodes.forEach((node, i) => {
                const rect = document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "rect",
                );
                rect.setAttribute("class", "node");
                rect.setAttribute("x", node.x);
                rect.setAttribute("y", node.y);
                rect.setAttribute("width", node.dx);
                rect.setAttribute("height", Math.max(1, node.dy)); // Ensure at least 1px
                rect.setAttribute(
                    "fill",
                    node.color || colorPalette[i % colorPalette.length],
                );
                rect.setAttribute("rx", 2);

                const label = document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "text",
                );
                label.setAttribute("class", "node-label");
                label.setAttribute("x", node.x + node.dx + 6);
                label.setAttribute("y", node.y + node.dy / 2);
                label.setAttribute("dy", "0.35em");
                label.textContent = `${node.name} (${Math.round(node.value)})`;

                // Check if label fits, or move to left if last column
                // Simplified: just draw it
                const isLast = !node.sourceLinks.length;
                if (isLast) {
                    label.setAttribute("x", node.x - 6);
                    label.setAttribute("text-anchor", "end");
                }

                svg.appendChild(rect);
                svg.appendChild(label);
            });

            function d3_interpolateNumber(a, b) {
                return function (t) {
                    return a * (1 - t) + b * t;
                };
            }
        }
    }

    function initSankey() {
        document.querySelectorAll(".sankey-container").forEach((el) => {
            const element = el;
            if (!element.dataset.initialized) {
                new SankeyChart(element);
                element.dataset.initialized = "true";
            }
        });
    }

    initSankey();
    document.addEventListener("astro:page-load", initSankey);
</script>
