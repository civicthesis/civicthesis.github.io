---
import FlourishContainer from "./FlourishContainer.astro";

interface Props {
    data: { code: string; value: number; name?: string }[];
    title?: string;
    subtitle?: string;
    source?: string;
    height?: number;
    theme?: "light" | "dark" | "auto";
}

const {
    data,
    title = "World Choropleth Map",
    subtitle = "Geospatial data visualization",
    source,
    height = 500,
    theme = "auto",
} = Astro.props;

const uniqueId = `map-${Math.random().toString(36).substr(2, 9)}`;
---

<FlourishContainer
    title={title}
    subtitle={subtitle}
    source={source}
    theme={theme}
    allowFullscreen={true}
>
    <div
        id={uniqueId}
        class="map-container"
        style={`height: ${height}px;`}
        data-chart-config={JSON.stringify({ data, theme })}
    >
        <!-- Tooltip -->
        <div class="map-tooltip"></div>
        <!-- Canvas/SVG Area -->
        <div class="chart-area"></div>
        <div class="loading-overlay">Loading Map Data...</div>
    </div>
</FlourishContainer>

<style>
    .map-container {
        position: relative;
        width: 100%;
        overflow: hidden;
        user-select: none;
        background: #f0f4f8; /* Sea color (light) */
    }

    :global(.dark) .map-container {
        background: #1e293b; /* Sea color (dark) */
    }

    .chart-area {
        width: 100%;
        height: 100%;
        position: relative;
    }

    /* Tooltip */
    .map-tooltip {
        position: absolute;
        top: 0;
        left: 0;
        background: rgba(0, 0, 0, 0.85);
        color: #fff;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 0.85rem;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, -100%);
        transition:
            opacity 0.2s,
            transform 0.2s;
        z-index: 10;
        white-space: nowrap;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .map-tooltip::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        margin-left: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: rgba(0, 0, 0, 0.85) transparent transparent transparent;
    }

    .loading-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 0.9rem;
        color: rgba(0, 0, 0, 0.5);
    }

    /* Path Styling */
    .map-container :global(path.country) {
        stroke: #fff;
        stroke-width: 0.5px;
        transition:
            fill 0.3s,
            stroke-width 0.3s;
        cursor: pointer;
        vector-effect: non-scaling-stroke;
    }

    .map-container :global(path.country:hover) {
        stroke: #000;
        stroke-width: 1px;
        opacity: 0.9;
    }

    :global(.dark) .map-container :global(path.country) {
        stroke: #333;
    }

    :global(.dark) .map-container :global(path.country:hover) {
        stroke: #fff;
    }
</style>

<script>
    // @ts-nocheck
    import * as d3 from "https://cdn.jsdelivr.net/npm/d3@7/+esm";

    class ChoroplethMap {
        el;
        config;
        chartArea;
        tooltip;
        loadingOverlay;
        resizeTimer;

        // Static cache for GeoJSON
        static geoData = null;

        constructor(el) {
            this.el = el;
            this.config = JSON.parse(el.dataset.chartConfig || "{}");
            this.chartArea = el.querySelector(".chart-area");
            this.tooltip = el.querySelector(".map-tooltip");
            this.loadingOverlay = el.querySelector(".loading-overlay");
            this.init();
        }

        async init() {
            if (!ChoroplethMap.geoData) {
                try {
                    // Fetch World Map (low res for performance)
                    const response = await fetch(
                        "https://raw.githubusercontent.com/holtzy/D3-graph-gallery/master/DATA/world.geojson",
                    );
                    ChoroplethMap.geoData = await response.json();
                } catch (e) {
                    console.error("Failed to load map data", e);
                    this.loadingOverlay.innerText = "Error loading map.";
                    return;
                }
            }

            this.loadingOverlay.style.display = "none";
            this.render(this.config.data);

            window.addEventListener("resize", () => {
                clearTimeout(this.resizeTimer);
                this.resizeTimer = setTimeout(
                    () => this.render(this.config.data),
                    200,
                );
            });
        }

        render(data) {
            this.chartArea.innerHTML = "";
            let { width, height } = this.el.getBoundingClientRect();
            if (!width || width === 0)
                width = this.el.offsetWidth || this.el.clientWidth || 800;
            if (!height || height === 0)
                height = this.el.offsetHeight || this.el.clientHeight || 500;

            const svg = d3
                .select(this.chartArea)
                .append("svg")
                .attr("width", width)
                .attr("height", height)
                .attr("viewBox", `0 0 ${width} ${height}`);

            // Map Projection: Natural Earth or Mercator
            // Use Natural Earth for better global visualization
            const projection = d3
                .geoNaturalEarth1()
                .scale(width / 1.5 / Math.PI)
                .translate([width / 2, height / 2]);

            const path = d3.geoPath().projection(projection);

            // Color Scale
            const dataMap = new Map();
            data.forEach((d) => {
                // Determine if code is ISO3 (USA) or Name.
                // The GeoJSON usually has "id" as ISO3 and properties like "name".
                dataMap.set(d.code, +d.value);
            });

            const values = data.map((d) => d.value);
            const min = d3.min(values) || 0;
            const max = d3.max(values) || 100;

            const colorScale = d3
                .scaleSequential()
                .interpolator(d3.interpolateBlues)
                .domain([min, max]);

            // Draw Map
            const group = svg.append("g");

            group
                .selectAll("path")
                .data(ChoroplethMap.geoData.features)
                .join("path")
                .attr("class", "country")
                .attr("d", path)
                .attr("fill", function (d) {
                    const value = dataMap.get(d.id) || 0;
                    if (!dataMap.has(d.id)) return "#ccc"; // No data
                    return colorScale(value);
                })
                .on("mouseenter", (event, d) => {
                    const value = dataMap.get(d.id);
                    d3.select(event.target)
                        .transition()
                        .duration(200)
                        .style("opacity", 1)
                        .style("stroke", "black")
                        .style("stroke-width", "1.5px");

                    // Determine content
                    let content = `
                        <div style="font-weight:600;">${d.properties.name}</div>
                    `;
                    if (value !== undefined) {
                        content += `<div>Value: <b>${value.toLocaleString()}</b></div>`;
                    } else {
                        content += `<div>No data</div>`;
                    }

                    this.tooltip.style.opacity = "1";
                    this.tooltip.innerHTML = content;
                })
                .on("mousemove", (event) => {
                    const [x, y] = d3.pointer(event, this.el);
                    // Adjust to be strictly within this element
                    // The tooltip is absolute in container, so x/y from pointer relative to SVG is good?
                    // d3.pointer returns local coordinates relative to target.
                    // We need coordinates relative to container.
                    // d3.pointer(event, this.chartArea)

                    // Native event is safer for simple tooltip
                    const chartRect = this.el.getBoundingClientRect();
                    this.tooltip.style.left = `${event.clientX - chartRect.left}px`;
                    this.tooltip.style.top = `${event.clientY - chartRect.top - 10}px`;
                })
                .on("mouseleave", (event) => {
                    d3.select(event.target)
                        .transition()
                        .duration(200)
                        .style("stroke", null)
                        .style("stroke-width", null);

                    this.tooltip.style.opacity = "0";
                });

            // Add Zoom/Pan (Optional but good for maps)
            // For now, static is fine for "Flourish-style" overview
        }
    }

    function initMap() {
        document.querySelectorAll(".map-container").forEach((el) => {
            const element = el;
            if (!element.dataset.initialized) {
                new ChoroplethMap(element);
                element.dataset.initialized = "true";
            }
        });
    }

    initMap();
    document.addEventListener("astro:page-load", initMap);
</script>
