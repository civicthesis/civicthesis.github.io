---
interface Props {
    type?: "chalkboard" | "whiteboard";
    class?: string;
}

const { type = "whiteboard", class: className } = Astro.props;
---

<div class={`board board-${type} ${className || ""}`}>
    <slot />
</div>

<style>
    .board {
        padding: 2rem;
        border-radius: 8px;
        margin: 2rem 0;
        position: relative;
        overflow: hidden;
        font-family: "Kalam", cursive;
    }

    /* Whiteboard Style */
    .board-whiteboard {
        background-color: #ffffff;
        border: 8px solid #e0e0e0;
        box-shadow:
            0 4px 6px rgba(0, 0, 0, 0.05),
            inset 0 0 20px rgba(0, 0, 0, 0.02);
        color: #333;
    }

    /* Chalkboard Style */
    .board-chalkboard {
        background-color: #2b2b2b;
        background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.05'/%3E%3C/svg%3E");
        border: 12px solid #5d4037;
        box-shadow:
            0 4px 8px rgba(0, 0, 0, 0.3),
            inset 0 0 50px rgba(0, 0, 0, 0.5);
        color: #eee;
        text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.3);
    }

    /* Adjust child elements for chalkboard */
    .board-chalkboard :global(h1),
    .board-chalkboard :global(h2),
    .board-chalkboard :global(h3),
    .board-chalkboard :global(p),
    .board-chalkboard :global(li) {
        color: #eee;
    }

    .board-chalkboard :global(code) {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }
</style>
