---
import DynamicPlaceholder from "../ui/DynamicPlaceholder.astro";
interface Props {
    category: string;
    count: number;
    image?: string;
    href: string;
    showArrow?: boolean;
}

const { category, count, image, href, showArrow = true } = Astro.props;
---

<a href={href} class="category-card">
    <div class="category-image">
        {
            image ? (
                <>
                    <img src={image} alt={category} loading="lazy" />
                    <div class="image-overlay" />
                </>
            ) : (
                <DynamicPlaceholder title={category} class="category-placeholder" />
            )
        }
    </div>
    <div class="category-content">
        <h3 class="category-name">{category}</h3>
        <p class="category-count">
            {count}
            {count === 1 ? "story" : "stories"}
        </p>
    </div>
    {showArrow && <div class="card-arrow">→</div>}
</a>

<style>
    .category-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--color-bg);
        border: 1.5px solid var(--color-border);
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .category-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        border-color: var(--color-primary);
    }

    .category-image {
        position: relative;
        width: 100%;
        height: 160px;
        background: var(--color-surface);
        overflow: hidden;
    }

    .category-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .category-card:hover .category-image img {
        transform: scale(1.08);
    }

    .placeholder-image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(
            135deg,
            var(--color-surface) 0%,
            var(--color-bg-offset) 100%
        );
        color: var(--color-text-muted);
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(0, 0, 0, 0.4) 100%
        );
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .category-card:hover .image-overlay {
        opacity: 1;
    }

    .category-content {
        padding: 1.25rem 1.5rem;
        flex: 1;
    }

    .category-name {
        font-size: 1.375rem;
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 0.5rem 0;
        text-transform: capitalize;
        transition: color 0.2s ease;
    }

    .category-card:hover .category-name {
        color: var(--color-primary);
    }

    .category-count {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--color-text-muted);
        margin: 0;
        font-family: var(--font-mono);
        letter-spacing: 0.02em;
    }

    .card-arrow {
        position: absolute;
        bottom: 1.25rem;
        right: 1.5rem;
        font-size: 1.5rem;
        color: var(--color-primary);
        opacity: 0;
        transform: translateX(-8px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .category-card:hover .card-arrow {
        opacity: 1;
        transform: translateX(0);
    }

    @media (max-width: 768px) {
        .category-image {
            height: 140px;
        }

        .category-content {
            padding: 1rem 1.25rem;
        }

        .category-name {
            font-size: 1.125rem;
        }
    }
</style>
