---
import { formatDate } from "../../utils";

interface Props {
    title: string;
    description: string;
    date: Date;
    image?: string;
    href: string;
    category: string;
    tags?: string[];
}

const {
    title,
    description,
    date,
    image,
    href,
    tags = [],
    category,
} = Astro.props;
---

<div class="story-card-horizontal group">
    {/* Main Link Overlay */}
    <a href={href} class="story-cover-link" aria-label={`Read ${title}`}>
        <span class="sr-only">Read Story</span>
    </a>

    <div class="image-container">
        {
            image ? (
                <img src={image} alt={title} loading="lazy" />
            ) : (
                <div class="pattern-fallback" aria-hidden="true">
                    <div class="logo-fallback">
                        CIVIC
                        <br />
                        Thesis
                    </div>
                </div>
            )
        }
    </div>
    <div class="content">
        <div class="meta-top">
            {category && <span class="category-tag">{category}</span>}
            <!-- <time datetime={date.toISOString()}>{formatDate(date)}</time> -->
        </div>

        <h3 class="title">{title}</h3>
    </div>
</div>

<style>
    .story-card-horizontal {
        display: flex;
        flex-direction: row;
        background: var(--color-surface);
        border-radius: 12px;
        overflow: hidden;
        position: relative;
        transition:
            transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
            box-shadow 0.4s ease,
            border-color 0.3s ease;
        border: 1px solid var(--color-border);
        height: 100%; /* Fill grid cell */
        min-height: 140px;
        /* Override accent color */
        --card-accent: #d97706;
    }

    .story-card-horizontal:hover {
        border-color: var(--card-accent);
        /* background-color: var(--color-surface-offset, #f9fafb); */
        z-index: 10;
        transform: translateY(-2px);
    }

    .story-cover-link {
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .image-container {
        position: relative;
        width: 35%; /* Fixed width for image part */
        min-width: 120px;
        max-width: 200px;
        flex-shrink: 0;
        overflow: hidden;
        z-index: 2;
        pointer-events: none;
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .story-card-horizontal:hover .image-container img {
        transform: scale(1.05);
    }

    .pattern-fallback {
        width: 100%;
        height: 100%;
        background-color: var(--color-surface-offset, #f3f4f6);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .logo-fallback {
        font-family: var(--font-heading);
        font-weight: 900;
        font-size: 1rem;
        line-height: 1;
        text-align: center;
        color: var(--color-text-muted);
        opacity: 0.2;
        transform: rotate(-10deg);
        text-transform: uppercase;
        pointer-events: none;
    }

    .content {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: center; /* Center content vertically */
        gap: 0.5rem;
        flex-grow: 1;
        position: relative;
        z-index: 2;
        pointer-events: none;
    }

    .meta-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.75rem;
        margin-bottom: 0.25rem;
    }

    .category-tag {
        font-family: var(--font-mono);
        color: var(--card-accent);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.7rem;
    }

    time {
        color: var(--color-text-muted);
    }

    .title {
        font-family: var(--font-carrois);
        font-size: 1.2rem;
        font-weight: 700;
        line-height: 1.3;
        margin: 0;
        color: var(--color-heading);
        transition: color 0.2s ease;
        /* Limit to 3 lines */
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .story-card-horizontal:hover .title {
        color: var(--card-accent);
    }

    @media (max-width: 480px) {
        /* On very small screens, maybe just reduce padding */
        .content {
            padding: 1rem;
        }
        .image-container {
            width: 30%;
        }
        .title {
            font-size: 1rem;
        }
    }
</style>
