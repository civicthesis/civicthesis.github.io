---

<button class="theme-toggle" id="theme-toggle" aria-label="Toggle Theme">
  <svg
    class="sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg
    class="moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg
    class="monitor-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
    <line x1="8" y1="21" x2="16" y2="21"></line>
    <line x1="12" y1="17" x2="12" y2="21"></line>
  </svg>
</button>

<style>
  button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    padding: 0.5rem;
    border-radius: 50%;
    transition: background-color 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 36px;
    height: 36px;
  }

  button:hover {
    background-color: var(--color-code-bg);
  }

  svg {
    position: absolute;
    transition:
      transform 0.5s cubic-bezier(0.25, 1, 0.5, 1),
      opacity 0.3s ease;
  }

  /* Default state (hidden) */
  .sun-icon,
  .moon-icon,
  .monitor-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  /* Active states based on parent class */
  :global(.theme-toggle[data-state="light"]) .sun-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.theme-toggle[data-state="dark"]) .moon-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global(.theme-toggle[data-state="auto"]) .monitor-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>

<script>
  // Declare globals
  declare global {
    interface Window {
      getTheme: () => string;
      applyTheme: (theme: string) => void;
    }
  }

  // Simple state machine
  const states = ["light", "dark", "auto"];

  const updateToggleUI = (theme: string) => {
    document.querySelectorAll(".theme-toggle").forEach((btn) => {
      btn.setAttribute("data-state", theme);

      // Update Accessible Label
      let label = "Toggle Theme (Current: Auto)";
      if (theme === "light") label = "Toggle Theme (Current: Light)";
      if (theme === "dark") label = "Toggle Theme (Current: Dark)";
      btn.setAttribute("aria-label", label);
    });
  };

  const handleToggleClick = () => {
    const currentTheme = window.getTheme();
    const currentIndex = states.indexOf(currentTheme);
    const nextIndex = (currentIndex + 1) % states.length;
    const nextTheme = states[nextIndex];

    // Update Storage
    if (nextTheme === "auto") {
      localStorage.removeItem("theme");
    } else {
      localStorage.setItem("theme", nextTheme);
    }

    // Apply
    window.applyTheme(nextTheme);
    updateToggleUI(nextTheme);
  };

  // Init
  const initThemeToggle = () => {
    const theme = window.getTheme();
    updateToggleUI(theme);

    const toggles = document.querySelectorAll(".theme-toggle");
    toggles.forEach((toggle) => {
      // Remove old listeners to prevent duplicates if using View Transitions
      toggle.removeEventListener("click", handleToggleClick);
      toggle.addEventListener("click", handleToggleClick);
    });
  };

  // Run on load and after swap
  document.addEventListener("astro:page-load", initThemeToggle);
  // Also run immediately for first load
  initThemeToggle();
</script>
