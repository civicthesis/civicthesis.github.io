---
import { formatDate } from "../../utils";

interface Props {
    title: string;
    description: string;
    date: Date;
    image?: string;
    href: string;
    institution: string;
    courseType: string;
    tags?: string[];
}

const {
    title,
    description,
    date,
    image,
    href,
    institution,
    courseType,
    tags = [],
} = Astro.props;
---

<a href={href} class="education-card group">
    <div class="image-container">
        {
            image ? (
                <img src={image} alt={title} loading="lazy" />
            ) : (
                <div class="pattern-fallback" aria-hidden="true">
                    <svg
                        width="100%"
                        height="100%"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <defs>
                            <pattern
                                id={`pattern-${title.replace(/\s+/g, "-").toLowerCase()}`}
                                x="0"
                                y="0"
                                width="20"
                                height="20"
                                patternUnits="userSpaceOnUse"
                            >
                                <circle
                                    cx="2"
                                    cy="2"
                                    r="1"
                                    class="pattern-dot"
                                />
                            </pattern>
                        </defs>
                        <rect
                            width="100%"
                            height="100%"
                            fill={`url(#pattern-${title.replace(/\s+/g, "-").toLowerCase()})`}
                        />
                    </svg>
                    <div class="logo-fallback">
                        {institution || "Education"}
                    </div>
                </div>
            )
        }
        <div class="overlay"></div>
        <div class="floating-badge">
            <span class="institution">{institution}</span>
            <span class="separator">•</span>
            <span class="course-type">{courseType}</span>
        </div>
    </div>

    <div class="card-body">
        <h3 class="title">{title}</h3>
        <!-- {description && <p class="description">{description}</p>} -->
    </div>
</a>

<style>
    .education-card {
        display: flex;
        flex-direction: column;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition:
            transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
            box-shadow 0.4s ease,
            border-color 0.3s ease;
        position: relative;
        height: 100%;
        --card-accent: #2563eb; /* Blue accent for education */
    }

    .education-card:hover {
        border-color: var(--card-accent);
        z-index: 10;
        /* transform: translateY(-4px); */
    }

    .image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 16/9;
        overflow: hidden;
        z-index: 2;
    }

    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .education-card:hover .image-container img {
        transform: scale(1.05);
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(0, 0, 0, 0.3) 100%
        );
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .education-card:hover .overlay {
        opacity: 1;
    }

    .floating-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(255, 255, 255, 0.95);
        color: var(--card-accent);
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        z-index: 10;
    }

    .separator {
        opacity: 0.4;
    }

    .pattern-fallback {
        width: 100%;
        height: 100%;
        background-color: var(--color-surface-offset, #f3f4f6);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .pattern-dot {
        fill: var(--color-border);
        opacity: 0.6;
    }

    .logo-fallback {
        position: absolute;
        font-family: var(--font-heading);
        font-weight: 900;
        font-size: 1.25rem;
        text-align: center;
        color: var(--color-text-muted);
        opacity: 0.2;
        transform: rotate(-10deg);
        z-index: 1;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        pointer-events: none;
        user-select: none;
    }

    :global(.dark) .pattern-fallback {
        background-color: #1a1a1a;
    }

    :global(.dark) .floating-badge {
        background: rgba(30, 30, 30, 0.95);
    }

    .card-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        gap: 0.75rem;
        position: relative;
        z-index: 2;
    }

    .title {
        font-family: var(--font-carrois);
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.3;
        margin: 0;
        color: var(--color-heading);
        transition: color 0.2s ease;
    }

    .education-card:hover .title {
        color: var(--card-accent);
    }

    .description {
        font-size: 0.95rem;
        color: var(--color-text);
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        opacity: 0.9;
    }
</style>
