---

---

<div class="search-wrapper" id="search-component">
  <div class="search-bar">
    <button id="search-trigger" aria-label="Toggle Search" class="icon-btn">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
    <div class="input-container">
      <input
        type="text"
        id="search-input"
        placeholder="Search topics, stories..."
        autocomplete="off"
      />
      <button id="close-search" aria-label="Clear search" class="clear-btn">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="search-dropdown" class="dropdown">
    <div id="search-results" class="results-list"></div>
    <div id="empty-state" class="empty-state hidden">
      <span>No results found</span>
    </div>
  </div>
</div>

<style>
  .search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    z-index: 50; /* Ensure high z-index context */
  }

  .search-bar {
    display: flex;
    align-items: center;
    background: transparent;
    border-radius: 8px;

    border: 1px solid transparent;
    position: relative;
    z-index: 20;
  }

  /* Expanded State */
  .search-wrapper.expanded .search-bar {
    background: var(--color-surface);
    /* border-color: var(--color-border); */
    /* box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); */
    padding-right: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .icon-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    padding: 0.6rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .icon-btn:hover {
    background: var(--color-bg-offset);
    color: var(--color-primary);
  }

  .input-container {
    display: flex;
    align-items: center;
    width: 0;
    overflow: hidden;
    opacity: 0;
  }

  .search-wrapper.expanded .input-container {
    width: 500px; /* Much wider search bar on desktop */
    opacity: 1;
    margin-left: 0.25rem;
  }

  /* Disable transition for mobile */
  @media (max-width: 768px) {
    .input-container {
      transition: none;
    }
    .search-bar {
      transition: none;
    }
  }

  /* Global styles to hide other header elements when search is expanded */
  :global(body.search-active) header .logo,
  :global(body.search-active) header .desktop-nav,
  :global(body.search-active) header .mobile-menu-btn {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  #search-input {
    background: transparent;
    border: none;
    font-size: 0.95rem;
    color: var(--color-text);
    outline: none;
    font-family: var(--font-sans);
    font-weight: 500;
    width: 100%;
    padding: 0.5rem 0;
  }

  #search-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .clear-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted);
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .search-wrapper.expanded .clear-btn {
    opacity: 0.5;
  }

  .search-wrapper.expanded .clear-btn:hover {
    opacity: 1;
  }

  /* Dropdown Results */
  .dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 100%; /* Match width of search bar */
    min-width: 400px; /* Minimum width for good readability */
    max-width: 90vw;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.1),
      0 8px 10px -6px rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
    z-index: 1001; /* Higher than mobile overlay */
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
    visibility: hidden; /* Start hidden */
    transition: all 0.2s ease;
  }

  .search-wrapper.has-results .dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
  }

  /* Remove hidden class usage for dropdown container itself to avoid confusion */
  .empty-state.hidden {
    display: none;
  }

  .results-list {
    max-height: 400px;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .empty-state {
    padding: 1.5rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  /* Result Items Styles */
  :global(.search-result-item) {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text);
    transition: background 0.15s ease;
  }

  :global(.search-result-item.selected) {
    background-color: var(--color-bg-offset);
    /* border-left: 3px solid var(--color-primary); Make selection obvious */
    /* padding-left: calc(1rem - 3px); Adjust padding to prevent layout shift */
  }

  :global(.search-thumb) {
    width: 60px;
    height: 45px;
    border-radius: 6px;
    object-fit: cover;
    background: var(--color-border);
    flex-shrink: 0;
  }

  :global(.search-thumb-placeholder) {
    width: 60px;
    height: 45px;
    border-radius: 6px;
    background: var(--color-code-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  :global(.search-result-content) {
    flex: 1;
    min-width: 0;
  }

  :global(.search-result-title) {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.search-result-meta) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  :global(.search-badge) {
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    /* Static toggle: Use fixed positioning to cover header reliably, but disable animation/transition */

    .search-wrapper.expanded .search-bar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 70px; /* Match header height approx or fixed height */
      background: var(--color-bg);
      justify-content: center; /* Center input */
      z-index: 2000;
      padding: 0 1rem;
      /* box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); */

      /* Force static behavior */
      animation: none;
      transition: none;
      transform: none;
      opacity: 1;
    }

    .search-wrapper.expanded .input-container {
      width: 100%;
    }

    .search-wrapper.expanded .dropdown {
      width: 100vw;
      min-width: 0;
      left: 0;
      right: 0;
      top: 0;
      margin-top: 70px; /* Offset by fixed bar height */
      position: fixed;
      z-index: 1999;
      border-radius: 0 0 12px 12px;
      max-height: calc(100vh - 70px);
      border-top: none;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
  }

  .search-section-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 0.5rem 1rem;
    letter-spacing: 0.05em;
  }

  .recent-search-item {
    cursor: pointer;
  }
</style>

<script>
  let Fuse: any;

  interface Post {
    title: string;
    description: string;
    slug: string;
    tags: string[];
    pubDate: string;
    type: string;
    image?: string;
  }

  let fuse: any;
  let posts: Post[] = [];
  let selectedIndex = -1;

  const wrapper = document.getElementById("search-component");
  const toggleBtn = document.getElementById("search-trigger");
  const input = document.getElementById("search-input") as HTMLInputElement;
  const closeBtn = document.getElementById("close-search");
  const dropdown = document.getElementById("search-dropdown");
  const resultsList = document.getElementById("search-results");
  const emptyState = document.getElementById("empty-state");

  const fetchPosts = async () => {
    if (posts.length > 0) return;
    try {
      if (!Fuse) {
        const fuseModule = await import("fuse.js");
        Fuse = fuseModule.default;
      }
      const res = await fetch("/api/posts.json");
      if (!res.ok) throw new Error("Failed to fetch posts");
      posts = await res.json();

      fuse = new Fuse(posts, {
        keys: [
          { name: "title", weight: 0.7 },
          { name: "description", weight: 0.3 },
          { name: "tags", weight: 0.2 },
        ],
        threshold: 0.4,
        includeScore: true,
      });

      // Retry search if input has value (fixes race condition)
      if (input.value.length > 0) {
        handleInput();
      }
    } catch (e) {
      console.error("Search init failed:", e);
    }
  };

  const toggleSearch = async () => {
    const isExpanded = wrapper?.classList.contains("expanded");
    if (!isExpanded) {
      wrapper?.classList.add("expanded");
      document.body.classList.add("search-active"); // Hide other elements
      input?.focus();
      await fetchPosts();
    } else {
      closeSearch();
    }
  };

  const closeSearch = () => {
    wrapper?.classList.remove("expanded");
    wrapper?.classList.remove("has-results");
    document.body.classList.remove("search-active"); // Show other elements
    if (input) input.value = "";
  };

  const handleInput = () => {
    const query = input.value;
    if (query.length === 0) {
      wrapper?.classList.remove("has-results");
      return;
    }

    if (!fuse) return;
    const results = fuse.search(query);

    if (results.length > 0) {
      wrapper?.classList.add("has-results");
      if (emptyState) emptyState.classList.add("hidden");
      if (resultsList) {
        resultsList.innerHTML = results
          .slice(0, 5)
          .map((r: any) => {
            const img = r.item.image
              ? `<img src="${r.item.image}" alt="" class="search-thumb" loading="lazy" />`
              : `<div class="search-thumb-placeholder"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg></div>`;

            return `
                <a href="/${r.item.slug}" class="search-result-item">
                    ${img}
                    <div class="search-result-content">
                        <span class="search-result-title">${r.item.title}</span>
                        <div class="search-result-meta">
                            <span class="search-badge">${r.item.type || "Story"}</span>
                         </div>
                    </div>
                </a>
             `;
          })
          .join("");

        // Attach mouseenter listeners to sync hover state
        const items = resultsList.querySelectorAll(".search-result-item");
        items.forEach((item, index) => {
          item.addEventListener("mouseenter", () => {
            selectedIndex = index;
            updateSelection();
          });
          // Save search on click
          item.addEventListener("click", () => {
            saveRecentSearch(input.value);
          });
        });
      }
    } else {
      wrapper?.classList.add("has-results");
      if (resultsList) resultsList.innerHTML = "";
      if (emptyState) emptyState.classList.remove("hidden");
    }
    selectedIndex = -1; // Reset selection on new input
  };

  const updateSelection = () => {
    const items = resultsList?.querySelectorAll(".search-result-item");
    if (!items) return;

    items.forEach((item, index) => {
      if (index === selectedIndex) {
        item.classList.add("selected");
        item.scrollIntoView({ block: "nearest" });
      } else {
        item.classList.remove("selected");
      }
    });
  };

  // Recent Searches Logic
  const getRecentSearches = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem("recent_searches") || "[]");
    } catch {
      return [];
    }
  };

  const saveRecentSearch = (query: string) => {
    if (!query || query.trim().length === 0) return;
    const history = getRecentSearches();
    const newHistory = [query, ...history.filter((h) => h !== query)].slice(
      0,
      5,
    );
    localStorage.setItem("recent_searches", JSON.stringify(newHistory));
  };

  const renderRecentSearches = () => {
    const history = getRecentSearches();
    if (history.length === 0) {
      wrapper?.classList.remove("has-results");
      if (resultsList) resultsList.innerHTML = "";
      return;
    }

    wrapper?.classList.add("has-results");
    if (resultsList) {
      resultsList.innerHTML = `
            <div class="search-section-title">Recent Searches</div>
            ${history
              .map(
                (query) => `
                <div class="search-result-item recent-search-item" role="button" tabindex="0">
                     <div class="search-thumb-placeholder" style="width: 32px; height: 32px; border-radius: 50%;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                     </div>
                     <div class="search-result-content">
                        <span class="search-result-title" style="font-weight: 500;">${query}</span>
                     </div>
                </div>
            `,
              )
              .join("")}
        `;

      // Attach click handlers
      const items = resultsList.querySelectorAll(".recent-search-item");
      items.forEach((item) => {
        item.addEventListener("click", (e) => {
          e.stopPropagation();
          const query =
            item.querySelector(".search-result-title")?.textContent || "";
          input.value = query;
          input.focus();
          handleInput();
        });
        // Keyboard support for recent items if needed?
        // Currently main keydown handles ArrowUp/Down which should work if they have class .search-result-item
      });

      // Attach mouseenter for hover-sync
      items.forEach((item, index) => {
        item.addEventListener("mouseenter", () => {
          selectedIndex = index;
          updateSelection();
        });
      });
    }
  };

  toggleBtn?.addEventListener("click", () => {
    // Logic from original toggle
    const isExpanded = wrapper?.classList.contains("expanded");
    if (!isExpanded) {
      wrapper?.classList.add("expanded");
      document.body.classList.add("search-active");
      input?.focus();
      fetchPosts();
      if (input.value.length === 0) renderRecentSearches();
    } else {
      closeSearch();
    }
  });

  closeBtn?.addEventListener("click", () => {
    if (input.value.length === 0) {
      closeSearch();
    } else {
      input.value = "";
      input.focus();
      // wrapper?.classList.remove("has-results"); // Don't remove active state totally?
      // Show recent searches instead of clearing everything
      renderRecentSearches();
      setTimeout(() => input.focus(), 10);
    }
  });

  input?.addEventListener("input", handleInput);

  document.addEventListener("click", (e) => {
    if (!wrapper?.contains(e.target as Node)) {
      closeSearch();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSearch();
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      if (!wrapper?.classList.contains("expanded")) {
        toggleSearch();
      } else {
        input.focus();
      }
    }
  });

  input?.addEventListener("keydown", (e) => {
    if (!wrapper?.classList.contains("has-results")) return;

    const items = resultsList?.querySelectorAll(".search-result-item");
    if (!items || items.length === 0) return;

    if (e.key === "ArrowDown") {
      e.preventDefault();
      if (selectedIndex === -1) {
        selectedIndex = 0;
      } else {
        selectedIndex = (selectedIndex + 1) % items.length;
      }
      updateSelection();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (selectedIndex === -1) {
        selectedIndex = items.length - 1;
      } else {
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
      }
      updateSelection();
    } else if (e.key === "Enter" && selectedIndex >= 0) {
      e.preventDefault();
      saveRecentSearch(input.value);
      (items[selectedIndex] as HTMLElement).click();
    }
  });
</script>
