---
import { hashString, generateVisuals, splitRects, getIsometricCube } from "../../utils/generative";

interface Props {
    title: string;
    category?: string;
    tags?: string[];
    class?: string;
}

const { title, category, tags = [], class: className } = Astro.props;
const seed = hashString(title + (category || ""));
const { palette, pattern, objects, rng, id } = generateVisuals({ seed, title, category, tags });

// Base colors for the gradient
const color1 = palette[0];
const color2 = palette[1];
const colorAccent = palette[2] || palette[0];

// Generate a unique prefix for IDs to avoid collisions
const prefix = `v3-${seed.toString(36)}`;
---

<div class={`dynamic-placeholder v3-engine ${className || ""}`} style={`--bg-1: ${color1}; --bg-2: ${color2}; --accent: ${colorAccent};`}>
    <svg viewBox="0 0 400 225" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" class="placeholder-svg">
        <filter id={`${prefix}-noise`}>
            <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" />
            <feColorMatrix type="saturate" values="0" />
            <feComponentTransfer>
                <feFuncA type="linear" slope="0.08" />
            </feComponentTransfer>
            <feBlend mode="overlay" in2="SourceGraphic" />
        </filter>

        <filter id={`${prefix}-bloom`} x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="5" result="blur" />
            <feComposite in="blur" in2="SourceGraphic" operator="over" />
        </filter>

        <filter id={`${prefix}-inner-shadow`}>
            <feOffset dx="0" dy="2" />
            <feGaussianBlur stdDeviation="3" result="offset-blur" />
            <feComposite operator="out" in="SourceGraphic" in2="offset-blur" result="inverse" />
            <feFlood flood-color="black" flood-opacity="0.2" result="color" />
            <feComposite operator="in" in="color" in2="inverse" result="shadow" />
            <feComposite operator="over" in="shadow" in2="SourceGraphic" />
        </filter>

        <defs>
            <linearGradient id={`${prefix}-grad`} x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style={`stop-color: ${color1}; stop-opacity: 1`} />
                <stop offset="50%" style={`stop-color: ${color2}; stop-opacity: 1`} />
                <stop offset="100%" style={`stop-color: ${colorAccent}; stop-opacity: 1`} />
            </linearGradient>

            <symbol id={`${prefix}-cube`} viewBox="0 0 100 100">
                {(() => {
                    const c = getIsometricCube(0, 30, 40);
                    return (
                        <g filter={`url(#${prefix}-inner-shadow)`}>
                            <path d={c.top} fill="white" fill-opacity="0.3" />
                            <path d={c.left} fill="white" fill-opacity="0.1" />
                            <path d={c.right} fill="white" fill-opacity="0.2" />
                        </g>
                    );
                })()}
            </symbol>
            
            <radialGradient id={`${prefix}-sphere-grad`}>
                <stop offset="0%" stop-color="white" stop-opacity="0.4" />
                <stop offset="100%" stop-color="white" stop-opacity="0.05" />
            </radialGradient>
        </defs>
        
        <rect width="100%" height="100%" fill={`url(#${prefix}-grad)`} />
        
        {/* Pattern Layer */}
        <g opacity="0.4" filter={`url(#${prefix}-noise)`}>
            {pattern === "mondrian" ? (
                 <g>
                    {splitRects(rng, 400, 225, 3).map((r) => (
                        <rect x={r.x} y={r.y} width={r.w} height={r.h} fill="white" fill-opacity="0.05" stroke="white" stroke-width="0.5" stroke-opacity="0.2" />
                    ))}
                 </g>
            ) : (
                <pattern id={`${prefix}-pattern`} x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
                    <circle cx="2" cy="2" r="1" fill="white" fill-opacity="0.2" />
                </pattern>
            )}
            <rect width="100%" height="100%" fill={pattern === "mondrian" ? "none" : `url(#${prefix}-pattern)`} />
        </g>

        {/* Generative Object Layer */}
        <g class="kinetic-objects">
            {objects.map((obj, i) => (
                <g 
                    transform={`translate(${obj.x}, ${obj.y}) rotate(${obj.rotation}) scale(${obj.size/50})`} 
                    opacity={obj.opacity}
                    style={`animation-delay: ${i * 0.5}s; --parallax: ${obj.parallax};`}
                    class="floating-node"
                >
                    {obj.type === "isometric-cube" && <use href={`#${prefix}-cube`} x="-50" y="-50" />}
                    {obj.type === "floating-sphere" && (
                        <circle r="25" fill={`url(#${prefix}-sphere-grad)`} stroke="white" stroke-opacity="0.2" filter={`url(#${prefix}-bloom)`} />
                    )}
                    {obj.type === "node-network" && (
                        <g stroke="white" stroke-width="0.5" stroke-opacity="0.5">
                            <line x1="-20" y1="-20" x2="20" y2="20" />
                            <circle cx="-20" cy="-20" r="3" fill="white" />
                            <circle cx="20" cy="20" r="3" fill="white" />
                        </g>
                    )}
                </g>
            ))}
        </g>

        {/* Metadata Overlay */}
        <text 
            x="380" 
            y="205" 
            text-anchor="end" 
            class="v3-label"
            fill="white"
            fill-opacity="0.3"
        >
            {category?.toUpperCase()}
        </text>
        
        <text 
            x="20" 
            y="40" 
            class="v3-branding"
            fill="white"
            fill-opacity="0.1"
        >
            {title.slice(0, 20).toUpperCase()}
        </text>
    </svg>

    <div class="glass-overlay"></div>
</div>

<style>
    .v3-engine {
        width: 100%;
        height: 100%;
        position: relative;
        background: var(--bg-1);
        overflow: hidden;
    }

    .placeholder-svg {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .v3-label {
        font-family: var(--font-carrois), sans-serif;
        font-weight: 900;
        font-size: 14px;
        letter-spacing: 0.2em;
    }

    .v3-branding {
        font-family: var(--font-carrois), sans-serif;
        font-weight: 900;
        font-size: 32px;
        letter-spacing: -0.05em;
    }

    .glass-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 100%);
        pointer-events: none;
    }

    .floating-node {
        animation: float 6s ease-in-out infinite alternate;
    }

    @keyframes float {
        0% { transform: translate(0, 0) rotate(0deg); }
        100% { transform: translate(calc(10px * var(--parallax)), calc(15px * var(--parallax))) rotate(5deg); }
    }
</style>
