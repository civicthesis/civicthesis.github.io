---
interface Props {
    title: string;
    category?: string;
    class?: string;
}

const { title, category, class: className } = Astro.props;

// Simple hash function for seed
const hashString = (str: string) => {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
        hash = (hash << 5) - hash + str.charCodeAt(i);
        hash |= 0;
    }
    return Math.abs(hash);
};

const seed = hashString(title);

// Brand colors
const colors = [
    ["#3B82F6", "#60A5FA"], // Blue
    ["#EC4899", "#F472B6"], // Pink
    ["#10B981", "#34D399"], // Emerald
    ["#F59E0B", "#FBBF24"], // Amber
    ["#6366F1", "#818CF8"], // Indigo
    ["#EF4444", "#F87171"], // Red
    ["#C5A059", "#D4B982"], // Gold
];

const selectedColors = colors[seed % colors.length];
const patternType = seed % 3; // 0: Dots, 1: Lines, 2: Triangles
---

<div
    class={`dynamic-placeholder ${className || ""}`}
    style={`--bg-1: ${selectedColors[0]}; --bg-2: ${selectedColors[1]};`}
>
    <svg
        viewBox="0 0 400 225"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid slice"
        class="placeholder-svg"
    >
        <defs>
            <linearGradient
                id={`grad-${seed}`}
                x1="0%"
                y1="0%"
                x2="100%"
                y2="100%"
            >
                <stop
                    offset="0%"
                    style={`stop-color: ${selectedColors[0]}; stop-opacity: 1`}
                ></stop>
                <stop
                    offset="100%"
                    style={`stop-color: ${selectedColors[1]}; stop-opacity: 1`}
                ></stop>
            </linearGradient>

            {
                patternType === 0 && (
                    <pattern
                        id={`pattern-${seed}`}
                        x="0"
                        y="0"
                        width="40"
                        height="40"
                        patternUnits="userSpaceOnUse"
                    >
                        <circle
                            cx="20"
                            cy="20"
                            r={2 + (seed % 6)}
                            fill="white"
                            fill-opacity="0.1"
                        />
                    </pattern>
                )
            }

            {
                patternType === 1 && (
                    <pattern
                        id={`pattern-${seed}`}
                        x="0"
                        y="0"
                        width="30"
                        height="30"
                        patternUnits="userSpaceOnUse"
                        patternTransform={`rotate(${seed % 360})`}
                    >
                        <line
                            x1="0"
                            y1="15"
                            x2="30"
                            y2="15"
                            stroke="white"
                            stroke-width={1 + (seed % 3)}
                            stroke-opacity="0.1"
                        />
                    </pattern>
                )
            }

            {
                patternType === 2 && (
                    <pattern
                        id={`pattern-${seed}`}
                        x="0"
                        y="0"
                        width="50"
                        height="50"
                        patternUnits="userSpaceOnUse"
                    >
                        <path
                            d="M 0 50 L 25 0 L 50 50 Z"
                            fill="white"
                            fill-opacity="0.05"
                        />
                    </pattern>
                )
            }
        </defs>

        <rect width="100%" height="100%" fill={`url(#grad-${seed})`}></rect>
        <rect width="100%" height="100%" fill={`url(#pattern-${seed})`}></rect>

        <g class="branding" opacity="0.15">
            <text
                x="50%"
                y="50%"
                text-anchor="middle"
                dominant-baseline="middle"
                class="logo-text"
                transform={`rotate(${(seed % 20) - 10} 200 112.5)`}
            >
                CIVIC Thesis
            </text>
        </g>
    </svg>
</div>

<style>
    .dynamic-placeholder {
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-1);
    }

    .placeholder-svg {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .logo-text {
        font-family: var(--font-carrois), sans-serif;
        font-weight: 900;
        font-size: 3rem;
        fill: white;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    /* Add a subtle animation to the pattern */
    .placeholder-svg rect[fill^="url(#pattern"] {
        animation: pulse-opacity 4s ease-in-out infinite alternate;
    }

    @keyframes pulse-opacity {
        from {
            opacity: 0.6;
        }
        to {
            opacity: 1;
        }
    }
</style>
