---
import { hashString, generateVisuals, splitRects } from "../../utils/generative";

interface Props {
    title: string;
    category?: string;
    class?: string;
}

const { title, category, class: className } = Astro.props;
// Use a more robust seed that includes category to differentiate topic cards from story cards
const seed = hashString(title + (category || ""));
const { palette, pattern, rng, id } = generateVisuals({ seed, title, category });

// Base colors for the gradient
const color1 = palette[0];
const color2 = palette[1];

// Generate a unique prefix for IDs to avoid collisions
const prefix = `gen-${seed.toString(36)}`;
---

<div class={`dynamic-placeholder ${className || ""}`} style={`--bg-1: ${color1}; --bg-2: ${color2};`}>
    <svg viewBox="0 0 400 225" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" class="placeholder-svg">
        <filter id={`${prefix}-noise`}>
            <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" />
            <feColorMatrix type="saturate" values="0" />
            <feComponentTransfer>
                <feFuncA type="linear" slope="0.05" />
            </feComponentTransfer>
            <feBlend mode="overlay" in2="SourceGraphic" />
        </filter>

        <defs>
            <linearGradient id={`${prefix}-grad`} x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style={`stop-color: ${color1}; stop-opacity: 1`} />
                <stop offset="100%" style={`stop-color: ${color2}; stop-opacity: 1`} />
            </linearGradient>

            {/* Pattern Definitions - Handling all expected pattern types or falling back */}
            {(pattern === "mondrian" || pattern === "bauhaus-rects" || pattern === "brutalist") && (
                <symbol id={`${prefix}-symbol`} viewBox="0 0 400 225">
                    {splitRects(rng, 400, 225, 4).map((r) => {
                        const filled = rng.next() > 0.6;
                        const rndColor = palette[rng.nextInt(0, palette.length)];
                        return (
                            <rect 
                                x={r.x} 
                                y={r.y} 
                                width={r.w} 
                                height={r.h} 
                                fill={filled ? rndColor : "white"} 
                                fill-opacity={filled ? 0.2 : 0.05} 
                                stroke="white" 
                                stroke-width="1" 
                                stroke-opacity="0.1" 
                            />
                        );
                    })}
                </symbol>
            )}

            {(pattern === "technical-grid" || pattern === "data-points" || pattern === "blueprint" || pattern === "histogram-bars") ? (
                <pattern id={`${prefix}-pattern`} x="0" y="0" width="30" height="30" patternUnits="userSpaceOnUse">
                    <line x1="0" y1="15" x2="30" y2="15" stroke="white" stroke-width="0.3" stroke-opacity="0.2" />
                    <line x1="15" y1="0" x2="15" y2="30" stroke="white" stroke-width="0.3" stroke-opacity="0.2" />
                    {pattern === "data-points" && <circle cx="15" cy="15" r="2" fill="white" fill-opacity="0.2" />}
                </pattern>
            ) : (
                <pattern id={`${prefix}-pattern`} x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <line x1="0" y1="50" x2="100" y2="50" stroke="white" stroke-width="1" stroke-opacity="0.1" />
                    <line x1="50" y1="0" x2="50" y2="100" stroke="white" stroke-width="1" stroke-opacity="0.1" />
                </pattern>
            )}
        </defs>
        
        <rect width="100%" height="100%" fill={`url(#${prefix}-grad)`} />
        
        {/* Pattern Layer */}
        {(pattern === "mondrian" || pattern === "bauhaus-rects" || pattern === "brutalist") ? (
             <use href={`#${prefix}-symbol`} filter={`url(#${prefix}-noise)`} />
        ) : (
             <rect width="100%" height="100%" fill={`url(#${prefix}-pattern)`} filter={`url(#${prefix}-noise)`} />
        )}

        {/* Brand Text */}
        <text 
            x="50%" 
            y="50%" 
            text-anchor="middle" 
            dominant-baseline="middle" 
            class="logo-text"
            fill="white"
            fill-opacity="0.15"
            transform={`rotate(${(seed % 10) - 5} 200 112.5)`}
        >
            {category?.toUpperCase() || "CIVIC THESIS"}
        </text>
    </svg>
</div>

<style>
    .dynamic-placeholder {
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
        background: var(--bg-1);
    }

    .placeholder-svg {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .logo-text {
        font-family: var(--font-carrois), sans-serif;
        font-weight: 900;
        font-size: 2.5rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
    }
</style>
