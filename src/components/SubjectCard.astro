---
interface Props {
    title: string;
    href: string;
    color?: string;
    icon?: string;
}

const { title, href, color = "var(--color-primary)", icon } = Astro.props;
---

<a href={href} class="subject-card">
    <div class="card-inner" style={`--card-color: ${color}`}>
        <div class="icon-wrapper">
            {
                icon ? (
                    <span class="icon">{icon}</span>
                ) : (
                    <div class="default-icon" />
                )
            }
        </div>
        <h3 class="title">{title}</h3>
        <div class="arrow">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                    points="12 5 19 12 12 19"></polyline></svg
            >
        </div>
    </div>
</a>

<style>
    .subject-card {
        text-decoration: none;
        color: inherit;
        display: block;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .subject-card:hover {
        transform: scale(1.02) rotate(-1deg);
        z-index: 10;
    }

    .card-inner {
        background: var(--color-surface);
        border: 2px solid var(--color-heading);
        border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
        padding: 2rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1rem;
        position: relative;
        box-shadow: 4px 4px 0 var(--color-heading);
        transition: all 0.2s ease;
    }

    .subject-card:hover .card-inner {
        box-shadow: 6px 6px 0 var(--card-color);
        border-color: var(--card-color);
    }

    .icon-wrapper {
        width: 60px;
        height: 60px;
        background: var(--card-color);
        border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.5rem;
        color: white;
        font-size: 1.5rem;
        border: 2px solid var(--color-heading);
        transition: border-radius 0.4s ease;
    }

    .subject-card:hover .icon-wrapper {
        border-radius: 50%;
        transform: rotate(10deg);
    }

    .default-icon {
        width: 20px;
        height: 20px;
        background: white;
        border-radius: 50%;
    }

    .title {
        font-family: "Playfair Display", serif;
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0;
        line-height: 1.3;
        color: var(--color-heading);
    }

    .arrow {
        margin-top: auto;
        color: var(--color-text-muted);
        transition: all 0.2s ease;
        opacity: 0;
        transform: translateX(-10px);
    }

    .subject-card:hover .arrow {
        opacity: 1;
        transform: translateX(0);
        color: var(--card-color);
    }
</style>
