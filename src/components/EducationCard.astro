---
import { formatDate } from "../utils";

interface Props {
    title: string;
    description: string;
    date: Date;
    image?: string;
    href: string;
    institution: string;
    courseType: string;
    tags?: string[];
}

const {
    title,
    description,
    date,
    image,
    href,
    institution,
    courseType,
    tags = [],
} = Astro.props;
---

<a href={href} class="education-card group">
    <div class="card-header">
        <div class="institution-badge">
            <span class="institution">{institution}</span>
            <span class="separator">•</span>
            <span class="course-type">{courseType}</span>
        </div>
        <div class="date">{formatDate(date)}</div>
    </div>

    <div class="card-body">
        <h3 class="title">{title}</h3>
        <p class="description">{description}</p>

        <div class="tags">
            {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
        </div>
    </div>

    <div class="card-footer">
        <span class="view-course">
            View Course
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="arrow"
            >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </span>
    </div>
</a>

<style>
    .education-card {
        display: flex;
        flex-direction: column;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        height: 100%;
    }

    .education-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: var(--color-primary);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .education-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.1);
        border-color: var(--color-primary);
    }

    .education-card:hover::before {
        opacity: 1;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        font-size: 0.85rem;
    }

    .institution-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: var(--color-primary);
        background: var(--color-primary-muted);
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
    }

    .separator {
        opacity: 0.5;
    }

    .date {
        color: var(--color-text-muted);
    }

    .card-body {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .title {
        font-family: "Playfair Display", serif;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.3;
        margin: 0;
        color: var(--color-heading);
    }

    .description {
        font-size: 0.95rem;
        color: var(--color-text);
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        opacity: 0.9;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
        margin-top: auto;
        padding-top: 1rem;
    }

    .tag {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        background: var(--color-bg);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        border: 1px solid var(--color-border);
    }

    .card-footer {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--color-border);
        display: flex;
        justify-content: flex-end;
    }

    .view-course {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--color-primary);
        transition: gap 0.3s ease;
    }

    .education-card:hover .view-course {
        gap: 0.75rem;
    }
</style>
