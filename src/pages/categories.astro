---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import CategoryCard from "../components/layout/CategoryCard.astro";

const stories = await getCollection("stories");

// Calculate category counts and get sample images
const categoryData = new Map<
    string,
    { count: number; image?: string; latestDate: Date }
>();

stories.forEach((story) => {
    const category = story.data.category || "Uncategorized";

    if (!categoryData.has(category)) {
        categoryData.set(category, {
            count: 0,
            image: story.data.image,
            latestDate: story.data.pubDate,
        });
    }

    const data = categoryData.get(category)!;
    data.count++;

    // Update image if this story is more recent and has an image
    if (story.data.pubDate > data.latestDate && story.data.image) {
        data.image = story.data.image;
        data.latestDate = story.data.pubDate;
    }
});

// Convert to array and sort alphabetically
const categories = Array.from(categoryData.entries())
    .map(([name, data]) => ({
        name,
        count: data.count,
        image: data.image,
    }))
    .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Categories | CivicThesis">
    <main>
        <section class="hero">
            <div class="container">
                <span class="label">EXPLORE</span>
                <h1>Categories</h1>
                <p class="subtitle">Browse stories by topic and interests.</p>
            </div>
        </section>

        <section class="categories-section">
            <div class="content-container">
                <div class="grid">
                    {
                        categories.map(({ name, count, image }) => (
                            <CategoryCard
                                category={name}
                                count={count}
                                image={image}
                                href={`/${name.toLowerCase()}`}
                            />
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    main {
        width: 100%;
        min-height: 80vh;
    }

    .content-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0;
    }

    .hero {
        padding: 4rem 0 3rem;
        text-align: center;
        background: linear-gradient(
            to bottom,
            var(--color-bg) 0%,
            var(--color-surface) 100%
        );
        border-bottom: 1px solid var(--color-border);
    }

    .label {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        letter-spacing: 0.1em;
        color: var(--color-accent);
        text-transform: uppercase;
        display: block;
        margin-bottom: 1rem;
    }

    h1 {
        font-family: "Playfair Display", serif;
        font-size: 4rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--color-heading);
        line-height: 1.1;
    }

    .subtitle {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin: 0 auto;
    }

    .categories-section {
        padding: 4rem 0 6rem;
        background: var(--color-bg);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    @media (max-width: 1024px) {
        .grid {
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 1.25rem;
        }
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 2.5rem;
        }

        .categories-section {
            padding: 3rem 0 4rem;
        }

        .grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
        }
    }

    @media (max-width: 480px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }
</style>
