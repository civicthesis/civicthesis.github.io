---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const stories = await getCollection("stories");

// Calculate category counts and get sample images
const categoryData = new Map<
    string,
    { count: number; image?: string; latestDate: Date }
>();

stories.forEach((story) => {
    const category = story.data.category || "Uncategorized";

    if (!categoryData.has(category)) {
        categoryData.set(category, {
            count: 0,
            image: story.data.image,
            latestDate: story.data.pubDate,
        });
    }

    const data = categoryData.get(category)!;
    data.count++;

    // Update image if this story is more recent and has an image
    if (story.data.pubDate > data.latestDate && story.data.image) {
        data.image = story.data.image;
        data.latestDate = story.data.pubDate;
    }
});

// Convert to array and sort alphabetically
const categories = Array.from(categoryData.entries())
    .map(([name, data]) => ({
        name,
        count: data.count,
        image: data.image,
    }))
    .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Categories | CivicThesis">
    <main>
        <section class="hero">
            <div class="container">
                <span class="label">EXPLORE</span>
                <h1>Categories</h1>
                <p class="subtitle">Browse stories by topic and interests.</p>
            </div>
        </section>

        <section class="categories-section">
            <div class="container">
                <div class="grid">
                    {
                        categories.map(({ name, count, image }) => (
                            <a
                                href={`/${name}`}
                                class="category-card"
                            >
                                <div class="category-image">
                                    {image ? (
                                        <>
                                            <img
                                                src={image}
                                                alt={name}
                                                loading="lazy"
                                            />
                                            <div class="image-overlay" />
                                        </>
                                    ) : (
                                        <div class="placeholder-image">
                                            <svg
                                                width="48"
                                                height="48"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                                            </svg>
                                        </div>
                                    )}
                                </div>
                                <div class="category-content">
                                    <h2 class="category-name">{name}</h2>
                                    <p class="category-count">
                                        {count}{" "}
                                        {count === 1 ? "story" : "stories"}
                                    </p>
                                </div>
                                <div class="card-arrow">→</div>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    main {
        width: 100%;
        min-height: 80vh;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .hero {
        padding: 4rem 0 3rem;
        text-align: center;
        background: linear-gradient(
            to bottom,
            var(--color-bg) 0%,
            var(--color-surface) 100%
        );
        border-bottom: 1px solid var(--color-border);
    }

    .label {
        font-family: var(--font-mono);
        font-size: 0.875rem;
        letter-spacing: 0.1em;
        color: var(--color-accent);
        text-transform: uppercase;
        display: block;
        margin-bottom: 1rem;
    }

    h1 {
        font-family: "Playfair Display", serif;
        font-size: 4rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--color-heading);
        line-height: 1.1;
    }

    .subtitle {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin: 0 auto;
    }

    .categories-section {
        padding: 4rem 0 6rem;
        background: var(--color-bg);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .category-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--color-bg);
        border: 1.5px solid var(--color-border);
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .category-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        border-color: var(--color-primary);
    }

    .category-image {
        position: relative;
        width: 100%;
        height: 160px;
        background: var(--color-surface);
        overflow: hidden;
    }

    .category-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .category-card:hover .category-image img {
        transform: scale(1.08);
    }

    .placeholder-image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(
            135deg,
            var(--color-surface) 0%,
            var(--color-bg-offset) 100%
        );
        color: var(--color-text-muted);
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(0, 0, 0, 0.4) 100%
        );
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .category-card:hover .image-overlay {
        opacity: 1;
    }

    .category-content {
        padding: 1.25rem 1.5rem;
        flex: 1;
    }

    .category-name {
        font-size: 1.375rem;
        font-weight: 700;
        color: var(--color-text);
        margin: 0 0 0.5rem 0;
        text-transform: capitalize;
        transition: color 0.2s ease;
    }

    .category-card:hover .category-name {
        color: var(--color-primary);
    }

    .category-count {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--color-text-muted);
        margin: 0;
        font-family: var(--font-mono);
        letter-spacing: 0.02em;
    }

    .card-arrow {
        position: absolute;
        bottom: 1.25rem;
        right: 1.5rem;
        font-size: 1.5rem;
        color: var(--color-primary);
        opacity: 0;
        transform: translateX(-8px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .category-card:hover .card-arrow {
        opacity: 1;
        transform: translateX(0);
    }

    @media (max-width: 1024px) {
        .grid {
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 1.25rem;
        }
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 2.5rem;
        }

        .categories-section {
            padding: 3rem 0 4rem;
        }

        .grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
        }

        .category-image {
            height: 140px;
        }

        .category-content {
            padding: 1rem 1.25rem;
        }

        .category-name {
            font-size: 1.125rem;
        }
    }

    @media (max-width: 480px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }
</style>
