---
import Layout from "../layouts/Layout.astro";
import FeaturedStoryCard from "../components/layout/FeaturedStoryCard.astro";
import StoryCard from "../components/layout/StoryCard.astro";
import GridCard from "../components/layout/GridCard.astro";
import StoryCardHorizontal from "../components/layout/StoryCardHorizontal.astro";
import FeaturedCategories from "../components/layout/FeaturedCategories.astro";
import { getCollection } from "astro:content";
import { featuredConfig } from "../config/featured";

// Define simpler types for content collection entries if full types aren't available
type CollectionEntry = {
	data: {
		title: string;
		description: string;
		pubDate: Date;
		image?: string;
		category?: string;
		tags?: string[];
	};
	slug: string;
};

const posts = (await getCollection("blog")).sort(
	(a: CollectionEntry, b: CollectionEntry) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Initial posts to display (for pagination)
const initialPostsCount = 6;
const allPosts = posts;
const initialPosts = posts.slice(0, initialPostsCount);

const stories = (await getCollection("stories")).sort(
	(a: CollectionEntry, b: CollectionEntry) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Featured story selection based on config
let featuredStory: CollectionEntry | undefined;

if (featuredConfig.featuredStorySlug) {
	// Manual selection: find story by slug
	featuredStory = stories.find(
		(s: CollectionEntry) => s.slug === featuredConfig.featuredStorySlug,
	);
}

if (!featuredStory) {
	// Auto selection based on strategy
	if (featuredConfig.selectionStrategy === "random") {
		const randomIndex = Math.floor(Math.random() * stories.length);
		featuredStory = stories[randomIndex];
	} else {
		// Default to newest
		featuredStory = stories[0];
	}
}

// Get stories for different sections (excluding the featured one)
const featuredStoryIndex = stories.findIndex(
	(s: CollectionEntry) => s.slug === featuredStory?.slug,
);

const allFilteredStories = stories.filter(
	(_: CollectionEntry, index: number) => index !== featuredStoryIndex,
);

const subStories = allFilteredStories.slice(0, featuredConfig.subFeaturedCount);
const secondaryStories = allFilteredStories.slice(
	featuredConfig.subFeaturedCount,
	featuredConfig.subFeaturedCount + featuredConfig.secondaryCount,
);
const horizontalStories = allFilteredStories.slice(
	featuredConfig.subFeaturedCount + featuredConfig.secondaryCount,
	featuredConfig.subFeaturedCount +
		featuredConfig.secondaryCount +
		featuredConfig.horizontalCount,
);
---

<Layout
	title="Home"
	description="Exploring data, society, and technology through a modern lens."
	image="/logo.png"
>
	<section class="featured-grid animate-fade-in">
		<div class="main-feature">
			{
				featuredStory && (
					<FeaturedStoryCard
						title={featuredStory.data.title}
						description={featuredStory.data.description}
						date={featuredStory.data.pubDate}
						image={featuredStory.data.image}
						href={`/stories/${featuredStory.slug}`}
						category={
							featuredStory.data.category || "Uncategorized"
						}
					/>
				)
			}
		</div>
		<div class="sub-features">
			{
				subStories.map((story) => (
					<StoryCard
						title={story.data.title}
						description={story.data.description}
						date={story.data.pubDate}
						image={story.data.image}
						href={`/stories/${story.slug}`}
						category={story.data.category}
						tags={story.data.tags}
					/>
				))
			}
		</div>
	</section>

	<section class="secondary-grid animate-fade-in">
		{
			secondaryStories.map((story) => (
				<GridCard
					title={story.data.title}
					description={story.data.description}
					date={story.data.pubDate}
					image={story.data.image}
					href={`/stories/${story.slug}`}
					category={story.data.category}
				/>
			))
		}
	</section>

	<section class="horizontal-grid animate-fade-in">
		{
			horizontalStories.map((story) => (
				<StoryCardHorizontal
					title={story.data.title}
					description={story.data.description}
					date={story.data.pubDate}
					image={story.data.image}
					href={`/stories/${story.slug}`}
					category={story.data.category}
				/>
			))
		}
	</section>

	<!-- Featured Categories Section -->
	<div class="container">
		<FeaturedCategories
			title="Explore Topics"
			maxCategories={6}
			showViewAll={true}
		/>
	</div>

	<div class="section-header">
		<h2 class="section-title">Latest from Blog</h2>
		<a href="/blog" class="see-all-link">See All →</a>
	</div>

	<section class="posts-grid" id="posts-container">
		{
			initialPosts.map((post) => (
				<article
					class="post-card animate-fade-in"
					data-post-slug={post.slug}
				>
					<a href={`/blog/${post.slug}`}>
						<div class="post-content">
							<span class="post-date">
								{post.data.pubDate.toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})}
							</span>
							<h2>{post.data.title}</h2>
						</div>
					</a>
				</article>
			))
		}
	</section>

	{
		allPosts.length > initialPostsCount && (
			<div class="load-more-container">
				<button id="load-more-btn" class="load-more-btn">
					Load More Posts
				</button>
				<p class="posts-count">
					Showing <span id="current-count">{initialPostsCount}</span>{" "}
					of {allPosts.length} posts
				</p>
			</div>
		)
	}
</Layout>

<style>
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: var(--spacing-lg);
		padding-top: var(--spacing-xl);
		/* border-top: 1px solid var(--color-border); */
	}

	.section-title {
		font-family: var(--font-carrois);
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 0;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.see-all-link {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--color-primary);
		font-weight: 600;
		text-decoration: none;
	}

	.see-all-link:hover {
		text-decoration: underline;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--spacing-lg);
	}

	/* Use :global() to ensure styles apply to dynamically created cards */
	:global(.post-card) {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		overflow: hidden;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	:global(.post-card:hover) {
		transform: translateY(-4px);
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
		border-color: var(--color-secondary);
	}

	:global(.post-card a) {
		display: block;
		height: 100%;
		padding: var(--spacing-lg);
		text-decoration: none;
		color: inherit;
	}

	:global(.post-card a:hover) {
		color: inherit;
	}

	:global(.post-date) {
		font-size: 0.875rem;
		color: #888;
		display: block;
		margin-bottom: var(--spacing-sm);
	}

	:global(.post-card h2) {
		font-size: 1.5rem;
		margin-bottom: var(--spacing-sm);
		line-height: 1.3;
	}

	:global(.post-card p) {
		color: #666;
		font-size: 1rem;
		margin-bottom: var(--spacing-md);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	:global(.post-tags) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	:global(.tag) {
		font-size: 0.75rem;
		background-color: var(--color-code-bg);
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		color: var(--color-text);
		font-family: var(--font-mono);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-lg);
		margin-bottom: var(--spacing-xl);
	}

	@media (max-width: 1024px) {
		.featured-grid {
			margin-top: var(--spacing-xl);
		}
	}

	.main-feature {
		height: 100%;
	}

	/* Force FeaturedStoryCard to fill height */
	.main-feature :global(.featured-card) {
		height: 100%;
		margin-bottom: 0;
	}

	.sub-features {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-md);
		align-content: start;
	}

	@media (max-width: 1024px) {
		.featured-grid {
			grid-template-columns: 1fr;
		}

		.sub-features {
			grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		}
	}

	.secondary-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-lg);
		margin-bottom: var(--spacing-xl);
	}

	@media (max-width: 900px) {
		.secondary-grid {
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		}
	}

	.horizontal-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-lg);
		margin-bottom: var(--spacing-xl);
	}

	@media (max-width: 900px) {
		.horizontal-grid {
			grid-template-columns: 1fr;
		}
	}

	.load-more-container {
		text-align: center;
		margin: var(--spacing-xl) 0;
		padding: var(--spacing-lg) 0;
	}

	.load-more-btn {
		padding: 1rem 2.5rem;
		background: var(--color-primary);
		color: var(--color-bg);
		border: none;
		border-radius: 8px;
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.3s ease;
		box-shadow: 0 4px 12px rgba(27, 42, 65, 0.2);
	}

	.load-more-btn:hover {
		background: var(--color-secondary);
		transform: translateY(-2px);
		box-shadow: 0 6px 16px rgba(27, 42, 65, 0.3);
	}

	.load-more-btn:disabled {
		background: var(--color-text-muted);
		cursor: not-allowed;
		transform: none;
	}

	.posts-count {
		margin-top: var(--spacing-sm);
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	#current-count {
		font-weight: 600;
		color: var(--color-primary);
	}

	/* Fade-in animation for newly loaded cards */
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.post-card.newly-loaded {
		animation: fadeInUp 0.5s ease-out forwards;
	}

	/* Loading spinner for button */
	.load-more-btn.loading {
		position: relative;
		color: transparent;
		pointer-events: none;
	}

	.load-more-btn.loading::after {
		content: "";
		position: absolute;
		width: 20px;
		height: 20px;
		top: 50%;
		left: 50%;
		margin-left: -10px;
		margin-top: -10px;
		border: 2px solid white;
		border-radius: 50%;
		border-top-color: transparent;
		animation: spin 0.6s linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
</style>

<script define:vars={{ allPosts, initialPostsCount }}>
	// Load More functionality
	let currentIndex = initialPostsCount;
	const postsPerLoad = 6;

	const loadMoreBtn = document.getElementById("load-more-btn");
	const postsContainer = document.getElementById("posts-container");
	const currentCountSpan = document.getElementById("current-count");

	if (loadMoreBtn && postsContainer && currentCountSpan) {
		loadMoreBtn.addEventListener("click", () => {
			// Add loading state
			loadMoreBtn.classList.add("loading");
			loadMoreBtn.disabled = true;

			// Small delay for better UX
			setTimeout(() => {
				const nextPosts = allPosts.slice(
					currentIndex,
					currentIndex + postsPerLoad,
				);

				// Create cards with staggered animation
				nextPosts.forEach((post, index) => {
					setTimeout(() => {
						// Create article element
						const article = document.createElement("article");
						article.className = "post-card newly-loaded";
						article.dataset.postSlug = post.slug;

						// Create link
						const link = document.createElement("a");
						link.href = `/blog/${post.slug}`;

						// Create content container
						const content = document.createElement("div");
						content.className = "post-content";

						// Create date element
						const date = new Date(post.data.pubDate);
						const formattedDate = date.toLocaleDateString("en-US", {
							year: "numeric",
							month: "long",
							day: "numeric",
						});

						const dateSpan = document.createElement("span");
						dateSpan.className = "post-date";
						dateSpan.textContent = formattedDate;

						// Create title element
						const title = document.createElement("h2");
						title.textContent = post.data.title;

						// Assemble the card
						content.appendChild(dateSpan);
						content.appendChild(title);
						link.appendChild(content);
						article.appendChild(link);

						// Add to container
						postsContainer.appendChild(article);

						// Remove newly-loaded class after animation
						setTimeout(() => {
							article.classList.remove("newly-loaded");
							article.classList.add("animate-fade-in");
						}, 500);
					}, index * 100); // Stagger by 100ms
				});

				// Update counter and button state after all cards are added
				setTimeout(
					() => {
						currentIndex += nextPosts.length;
						currentCountSpan.textContent = currentIndex.toString();

						// Remove loading state
						loadMoreBtn.classList.remove("loading");

						// Check if all posts are loaded
						if (currentIndex >= allPosts.length) {
							loadMoreBtn.disabled = true;
							loadMoreBtn.textContent = "All Posts Loaded";
						} else {
							loadMoreBtn.disabled = false;
						}

						// Smooth scroll to first new post
						const allCards =
							postsContainer.querySelectorAll(".post-card");
						if (allCards.length > 0) {
							const firstNewCard =
								allCards[allCards.length - nextPosts.length];
							if (firstNewCard) {
								setTimeout(() => {
									firstNewCard.scrollIntoView({
										behavior: "smooth",
										block: "nearest",
									});
								}, 200);
							}
						}
					},
					nextPosts.length * 100 + 100,
				);
			}, 300);
		});
	}
</script>
