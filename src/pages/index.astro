---
import Layout from "../layouts/Layout.astro";
import FeaturedStoryCard from "../components/FeaturedStoryCard.astro";
import StoryCard from "../components/StoryCard.astro";
import GridCard from "../components/GridCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const stories = (await getCollection("stories")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Try to find OG Crew, otherwise default to first story
const featuredStoryIndex = stories.findIndex((s) => s.slug.includes("og-crew"));
const featuredStory =
	featuredStoryIndex >= 0 ? stories[featuredStoryIndex] : stories[0];

// Get next 4 stories for sub-features (excluding the featured one)
const allFilteredStories = stories.filter((_, index) =>
	featuredStoryIndex >= 0 ? index !== featuredStoryIndex : index !== 0,
);

const subStories = allFilteredStories.slice(0, 4);
const secondaryStories = allFilteredStories.slice(4, 7); // Taking next 3 for grid
---

<Layout
	title="Home"
	description="Exploring data, society, and technology through a modern lens."
	image="/logo.png"
>
	<section class="hero animate-fade-in">
		<h1>
			<span class="civic">CIVIC</span>
			<span class="thesis">Thesis</span>
		</h1>
		<p class="subtitle">
			Exploring data, society, and technology through a modern lens.
		</p>
	</section>

	<section class="featured-grid animate-fade-in">
		<div class="main-feature">
			{
				featuredStory && (
					<FeaturedStoryCard
						title={featuredStory.data.title}
						description={featuredStory.data.description}
						date={featuredStory.data.pubDate}
						image={featuredStory.data.image}
						href={`/stories/${featuredStory.slug}`}
						category={featuredStory.data.category}
					/>
				)
			}
		</div>
		<div class="sub-features">
			{
				subStories.map((story) => (
					<StoryCard
						title={story.data.title}
						description={story.data.description}
						date={story.data.pubDate}
						image={story.data.image}
						href={`/stories/${story.slug}`}
						category={story.data.category}
						tags={story.data.tags}
					/>
				))
			}
		</div>
	</section>

	<section class="secondary-grid animate-fade-in">
		{
			secondaryStories.map((story) => (
				<GridCard
					title={story.data.title}
					description={story.data.description}
					date={story.data.pubDate}
					image={story.data.image}
					href={`/stories/${story.slug}`}
					category={story.data.category}
				/>
			))
		}
	</section>

	<section class="posts-grid">
		{
			posts.map((post) => (
				<article class="post-card animate-fade-in">
					<a href={`/blog/${post.slug}`}>
						<div class="post-content">
							<span class="post-date">
								{post.data.pubDate.toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})}
							</span>
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
							<div class="post-tags">
								{post.data.tags.map((tag) => (
									<span class="tag">#{tag}</span>
								))}
							</div>
						</div>
					</a>
				</article>
			))
		}
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: var(--spacing-xl) 0;
		margin-bottom: var(--spacing-xl);
	}

	.hero h1 {
		font-size: 4rem;
		margin-bottom: var(--spacing-sm);
	}

	.highlight {
		color: var(--color-primary);
	}

	.subtitle {
		font-size: 1.25rem;
		color: #666;
		max-width: 600px;
		margin: 0 auto;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--spacing-lg);
	}

	.post-card {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		overflow: hidden;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
		border-color: var(--color-secondary);
	}

	.post-card a {
		display: block;
		height: 100%;
		padding: var(--spacing-lg);
		text-decoration: none;
		color: inherit;
	}

	.post-card a:hover {
		color: inherit;
	}

	.post-date {
		font-size: 0.875rem;
		color: #888;
		display: block;
		margin-bottom: var(--spacing-sm);
	}

	.post-card h2 {
		font-size: 1.5rem;
		margin-bottom: var(--spacing-sm);
		line-height: 1.3;
	}

	.post-card p {
		color: #666;
		font-size: 1rem;
		margin-bottom: var(--spacing-md);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		font-size: 0.75rem;
		background-color: var(--color-code-bg);
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		color: var(--color-text);
		font-family: var(--font-mono);
	}

	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.5rem;
		}
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: var(--spacing-lg);
		margin-bottom: var(--spacing-xl);
	}

	.main-feature {
		height: 100%;
	}

	/* Force FeaturedStoryCard to fill height */
	.main-feature :global(.featured-card) {
		height: 100%;
		margin-bottom: 0;
	}

	.sub-features {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-md);
		align-content: start;
	}

	@media (max-width: 1024px) {
		.featured-grid {
			grid-template-columns: 1fr;
		}

		.sub-features {
			grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		}
	}

	.secondary-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-lg);
		margin-bottom: var(--spacing-xl);
	}

	@media (max-width: 900px) {
		.secondary-grid {
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		}
	}
</style>
