---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
	title="Home"
	description="Exploring data, society, and technology through a modern lens."
	image="/logo.png"
>
	<section class="hero animate-fade-in">
		<h1>
			<span class="civic">CIVIC</span>
			<span class="thesis">Thesis</span>
		</h1>
		<p class="subtitle">
			Exploring data, society, and technology through a modern lens.
		</p>
	</section>

	<section class="posts-grid">
		{
			posts.map((post) => (
				<article class="post-card animate-fade-in">
					<a href={`/blog/${post.slug}`}>
						<div class="post-content">
							<span class="post-date">
								{post.data.pubDate.toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})}
							</span>
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
							<div class="post-tags">
								{post.data.tags.map((tag) => (
									<span class="tag">#{tag}</span>
								))}
							</div>
						</div>
					</a>
				</article>
			))
		}
	</section>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: var(--spacing-xl) 0;
		margin-bottom: var(--spacing-xl);
	}

	.hero h1 {
		font-size: 4rem;
		margin-bottom: var(--spacing-sm);
	}

	.highlight {
		color: var(--color-primary);
	}

	.subtitle {
		font-size: 1.25rem;
		color: #666;
		max-width: 600px;
		margin: 0 auto;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: var(--spacing-lg);
	}

	.post-card {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		overflow: hidden;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}

	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
		border-color: var(--color-secondary);
	}

	.post-card a {
		display: block;
		height: 100%;
		padding: var(--spacing-lg);
		text-decoration: none;
		color: inherit;
	}

	.post-card a:hover {
		color: inherit;
	}

	.post-date {
		font-size: 0.875rem;
		color: #888;
		display: block;
		margin-bottom: var(--spacing-sm);
	}

	.post-card h2 {
		font-size: 1.5rem;
		margin-bottom: var(--spacing-sm);
		line-height: 1.3;
	}

	.post-card p {
		color: #666;
		font-size: 1rem;
		margin-bottom: var(--spacing-md);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		font-size: 0.75rem;
		background-color: var(--color-code-bg);
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		color: var(--color-text);
		font-family: var(--font-mono);
	}

	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.5rem;
		}
	}
</style>
