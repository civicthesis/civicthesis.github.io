---
import Layout from "../../../layouts/Layout.astro";
import StoryCard from "../../../components/layout/StoryCard.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const allStories = await getCollection("stories");
    const uniqueTags = [
        ...new Set(allStories.map((story) => story.data.tags).flat()),
    ];

    return uniqueTags.map((tag) => {
        const filteredStories = allStories.filter((story) =>
            story.data.tags.includes(tag),
        );
        return {
            params: { tag },
            props: { stories: filteredStories },
        };
    });
}

const { tag } = Astro.params;
const { stories } = Astro.props;

// Sort stories by date
const sortedStories = stories.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={`Stories tagged with ${tag} | CivicThesis`}>
    <main>
        <section class="hero">
            <div class="container">
                <div class="breadcrumb">
                    <a href="/stories">Stories</a>
                    <span class="separator">/</span>
                    <span class="current">Tags</span>
                </div>
                <h1>{tag}</h1>
                <p class="subtitle">
                    {stories.length}
                    {stories.length === 1 ? "story" : "stories"} found
                </p>
            </div>
        </section>

        <section class="stories-grid">
            <div class="container">
                <div class="grid">
                    {
                        sortedStories.map((story) => (
                            <StoryCard
                                title={story.data.title}
                                description={story.data.description}
                                date={story.data.pubDate}
                                image={story.data.image}
                                href={`/stories/${story.slug}`}
                                tags={story.data.tags}
                                category={story.data.category}
                            />
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    main {
        width: 100%;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .hero {
        padding: 6rem 0 4rem;
        text-align: center;
        background: linear-gradient(
            to bottom,
            var(--color-bg) 0%,
            var(--color-surface) 100%
        );
        border-bottom: 1px solid var(--color-border);
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        font-size: 0.9rem;
        color: var(--color-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 500;
    }

    .breadcrumb a {
        color: inherit;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .breadcrumb a:hover {
        color: var(--color-primary);
    }

    h1 {
        font-family: "Playfair Display", serif;
        font-size: 4.5rem;
        font-weight: 700;
        font-style: italic;
        margin-bottom: 0.5rem;
        color: var(--color-heading);
        letter-spacing: -0.02em;
        line-height: 1.1;
        text-transform: capitalize;
    }

    .subtitle {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin: 0 auto;
    }

    .stories-grid {
        padding: 4rem 0 6rem;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2.5rem;
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 2.5rem;
        }

        .hero {
            padding: 4rem 0 3rem;
        }

        .grid {
            grid-template-columns: 1fr;
        }
    }
</style>
