---
import Layout from "../layouts/Layout.astro";
import StoryCard from "../components/layout/StoryCard.astro";
import Breadcrumb from "../components/layout/Breadcrumb.astro";
import RelatedCategories from "../components/layout/RelatedCategories.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const stories = await getCollection("stories");
    const uniqueCategories = [
        ...new Set(stories.map((story) => story.data.category).filter(Boolean)),
    ];

    return uniqueCategories.map((category) => {
        const filteredStories = stories.filter(
            (story) => story.data.category === category,
        );
        return {
            params: { category: category },
            props: { stories: filteredStories, category: category },
        };
    });
}

const { stories, category } = Astro.props;
const sortedStories = stories.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Breadcrumb items
const breadcrumbItems = [
    { label: "Home", href: "/" },
    { label: "Stories", href: "/stories" },
    { label: category, href: `/${category}` },
];
---

<Layout title={`Stories in ${category} | CivicThesis`}>
    <main>
        
        <section class="hero">
            <div class="container">
                <Breadcrumb items={breadcrumbItems} />
            </div>
            <div class="container">
                <span class="category-label">TOPIC</span>
                <h1>{category}</h1>
                <p class="subtitle">
                    Latest stories and updates in {category}.
                </p>
                <p class="story-count">
                    {sortedStories.length}
                    {sortedStories.length === 1 ? "story" : "stories"}
                </p>
            </div>
        </section>

        <section class="stories-grid">
            <div class="container">
                <div class="grid">
                    {
                        sortedStories.map((story) => (
                            <StoryCard
                                title={story.data.title}
                                description={story.data.description}
                                date={story.data.pubDate}
                                image={story.data.image}
                                href={`/stories/${story.slug}`}
                                tags={story.data.tags}
                                category={story.data.category}
                            />
                        ))
                    }
                </div>
            </div>
        </section>

        <div class="container">
            <RelatedCategories currentCategory={category} />
        </div>
    </main>
</Layout>

<style>
    main {
        width: 100%;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .hero {
        padding: 4rem 0 2rem;
        text-align: center;
        background: linear-gradient(
            to bottom,
            var(--color-bg) 0%,
            var(--color-surface) 100%
        );
        border-bottom: 1px solid var(--color-border);
    }

    .category-label {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-accent);
        margin-bottom: 1rem;
    }

    h1 {
        font-family: "Playfair Display", serif;
        font-size: 4rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--color-heading);
        line-height: 1.1;
        text-transform: capitalize;
    }

    .subtitle {
        font-size: 1.25rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin: 0 auto 0.5rem;
    }

    .story-count {
        font-size: 1rem;
        color: var(--color-primary);
        font-weight: 600;
        margin: 0;
    }

    .stories-grid {
        padding: 4rem 0 6rem;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2.5rem;
    }

    @media (max-width: 768px) {
        h1 {
            font-size: 2.5rem;
        }

        .hero {
            padding: 3rem 0 2rem;
        }

        .grid {
            grid-template-columns: 1fr;
        }
    }
</style>
