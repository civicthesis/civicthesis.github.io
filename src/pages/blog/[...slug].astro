---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import ScribbleBox from "../../components/scribble/ScribbleBox.astro";
import ScribbleHighlight from "../../components/scribble/ScribbleHighlight.astro";
import ScribbleCircle from "../../components/scribble/ScribbleCircle.astro";
import DiagramArrow from "../../components/scribble/DiagramArrow.astro";
import Chart from "../../components/Chart.astro";
import Mermaid from "../../components/Mermaid.astro";
import Emoji from "../../components/Emoji.astro";

import OptimizedImage from "../../components/OptimizedImage.astro";
import TypingText from "../../components/TypingText.astro";
import StyledMath from "../../components/StyledMath.astro";
import Board from "../../components/Board.astro";
import ScribbleCheck from "../../components/scribble/ScribbleCheck.astro";
import ScribbleLine from "../../components/scribble/ScribbleLine.astro";
import BarChart from "../../components/BarChart.astro";
import CustomTable from "../../components/CustomTable.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

const components = {
	ScribbleBox,
	ScribbleHighlight,
	ScribbleCircle,
	DiagramArrow,
	Chart,
	Mermaid,
	Emoji,
	OptimizedImage,
	TypingText,
	StyledMath,
	Board,
	ScribbleCheck,
	ScribbleLine,
	BarChart,
	CustomTable,
};

const post = Astro.props;
const { Content } = await post.render();
const url = new URL(Astro.url.pathname, Astro.site);
---

<Layout
	title={post.data.title}
	description={post.data.description}
	image={post.data.image}
	type="article"
>
	<article class="blog-post animate-fade-in">
		<header class="post-header">
			<div class="post-meta">
				<time datetime={post.data.pubDate.toISOString()}>
					{
						post.data.pubDate.toLocaleDateString("en-US", {
							year: "numeric",
							month: "long",
							day: "numeric",
						})
					}
				</time>
				<span class="separator">•</span>
				<span class="author">By {post.data.author}</span>
			</div>
			<h1>{post.data.title}</h1>
			<div class="tags">
				{post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
			</div>
		</header>

		<div class="prose">
			<Content components={components} />
		</div>

		<ShareButtons title={post.data.title} url={url} />
	</article>
</Layout>

<style>
	.blog-post {
		max-width: 800px;
		margin: 0 auto;
		padding: var(--spacing-lg) 0;
	}

	.post-header {
		text-align: center;
		margin-bottom: var(--spacing-xl);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: var(--spacing-lg);
	}

	.post-meta {
		color: #888;
		font-size: 0.9rem;
		margin-bottom: var(--spacing-sm);
	}

	.separator {
		margin: 0 0.5rem;
	}

	h1 {
		font-size: 3rem;
		margin-bottom: var(--spacing-md);
		letter-spacing: -0.03em;
	}

	.tags {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
	}

	.tag {
		font-size: 0.8rem;
		background-color: var(--color-code-bg);
		padding: 0.25rem 0.75rem;
		border-radius: 99px;
		color: var(--color-text);
		font-family: var(--font-mono);
	}
</style>
